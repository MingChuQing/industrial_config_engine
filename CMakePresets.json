{
	"version": 3,
	"configurePresets": [
		{
			"name": "default",
			"displayName": "Default Config",
			"description": "默认构建配置",
			"generator": "Ninja",
			"binaryDir": "${sourceDir}/build/${presetName}",
			"cacheVariables": {
				"CMAKE_CXX_STANDARD": "17",
				"CMAKE_CXX_STANDARD_REQUIRED": "ON",
				"BUILD_TESTS": "ON",
				"BUILD_DEMOS": "ON"
			}
		},
		{
			"name": "debug",
			"displayName": "Debug Config",
			"description": "调试构建配置",
			"inherits": "default",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug"
			}
		},
		{
			"name": "release",
			"displayName": "Release Config",
			"description": "发布构建配置",
			"inherits": "default",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release"
			}
		}
	],
	"buildPresets": [
		{
			"name": "debug",
			"configurePreset": "debug"
		},
		{
			"name": "release",
			"configurePreset": "release"
		}
	]
}