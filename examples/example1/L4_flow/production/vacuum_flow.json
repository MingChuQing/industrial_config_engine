{
"type": "flow",
"name": "Vacuum Process Flow",
"description": "Complete vacuum evacuation process flow with parameter configuration, Evacuation, pressure hold and Leak Test",
"version": "2.1.0",
"timeout_ms": 7200000,
"max_retries": 0,
"profiles": {
"test": {
"description": "Test mode - relaxed parameters",
"params": {
"vacuum_target": 10.0,
"pump_timeout": 120000,
"hold_time": 30,
"leak_threshold": 2.0,
"confirm_between": false
}
},
"production": {
"description": "Production mode - standard parameters",
"params": {
"vacuum_target": 5.0,
"pump_timeout": 300000,
"hold_time": 60,
"leak_threshold": 0.5,
"confirm_between": false
}
},
"high_precision": {
"description": "High precision mode - strict parameters",
"params": {
"vacuum_target": 1.0,
"pump_timeout": 600000,
"hold_time": 120,
"leak_threshold": 0.1,
"confirm_between": false
}
},
"debug": {
"description": "Debug mode - per-step confirmation",
"params": {
"vacuum_target": 5.0,
"pump_timeout": 600000,
"hold_time": 60,
"leak_threshold": 0.5,
"confirm_between": true
}
}
},
"active_profile": "production",
"body": [
{
"type": "group",
"name": "Phase 1: System Check",
"template": "L3_group/common/system_check.group",
"timeout_ms": 30000,
"confirm_between": "{profile.confirm_between}" }, { "type": "group", "name": "Phase 2: Evacuation", "template": "L3_group/vacuum/pump_down.group", "timeout_ms": "{profile.pump_timeout}",
"confirm_between": "{profile.confirm_between}" }, { "type": "group", "name": "Phase 3: Pressure Hold", "template": "L3_group/vacuum/hold_pressure.group", "timeout_ms": 180000, "confirm_between": "{profile.confirm_between}"
},
{
"type": "group",
"name": "Phase 4: Leak Test",
"template": "L3_group/vacuum/leak_test.group",
"timeout_ms": 120000,
"confirm_between": "{profile.confirm_between}" }, { "type": "group", "name": "Phase 5: Result Log", "template": "L3_group/common/log_result.group", "timeout_ms": 10000, "confirm_between": "{profile.confirm_between}"
}
],
"on_timeout": [
{ "type": "log", "message": "[TIMEOUT] Vacuum Process Flowoverall timeout" },
{
"type": "group",
"template": "L3_group/common/emergency_stop.group"
},
{
"type": "node",
"name": "Timeout alarm",
"result_key": "popup_result",
"params": ["Vacuum Process Flowtimeout, auto-stopped", "error"],
"timeout_ms": 3000,
"max_retries": 0,
"retry_interval": 0,
"action": { "template": "L1_action/system/popup.s_s" },
"on_success": [],
"on_failure": []
}
],
"on_emergency_cleanup": {
"type": "sequence",
"body": [
{
"type": "group",
"name": "Global emergency shutdown",
"template": "L3_group/common/emergency_stop.group"
},
{
"type": "node",
"name": "Emergency log",
"result_key": "log_result",
"params": ["[EMERGENCY] Vacuum Process Flowemergency stop cleanup done"],
"timeout_ms": 2000,
"max_retries": 2,
"retry_interval": 500,
"action": { "template": "L1_action/system/log.s" },
"on_success": [],
"on_failure": []
},
{
"type": "node",
"name": "emergency stop popup",
"result_key": "popup_result",
"params": ["Emergency stop! Check and reset", "error"],
"timeout_ms": 3000,
"max_retries": 0,
"retry_interval": 0,
"action": { "template": "L1_action/system/popup.s_s" },
"on_success": [],
"on_failure": []
}
],
"inherit_parent": "skip"
}
}