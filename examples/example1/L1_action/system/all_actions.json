{
"type": "action_bundle",
"description": "system action collection",
"version": "1.0.0",
"actions": [
{
"filename": "log.s",
"type": "log",
"description": "write log",
"message": "{message}", "args": [ { "index": 0, "name": "message", "type": "s", "desc": "Log content" } ] }, { "filename": "popup.s_s", "type": "popup", "description": "popup prompt to user", "message": "{message}",
"level": "${level}",
"args": [
{ "index": 0, "name": "message", "type": "s", "desc": "prompt content" },
{ "index": 1, "name": "level", "type": "s", "enum": ["info", "warning", "error", "success"], "default": "info", "desc": "prompt level" }
]
}
]
}