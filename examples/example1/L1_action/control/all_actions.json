{
    "type": "action_bundle",
    "description": "control action collection - Evacuationsystem",
    "version": "1.0.0",
    "actions": [
        {
            "filename": "wait.u16_s.r_b_wait_done",
            "type": "wait",
            "description": "wait specified duration",
            "duration": "${duration}",
            "unit": "${unit}",
            "args": [
                {
                    "index": 0,
                    "name": "duration",
                    "type": "u16",
                    "min": 1,
                    "max": 65535,
                    "desc": "wait duration"
                },
                {
                    "index": 1,
                    "name": "unit",
                    "type": "s",
                    "enum": [ "ms", "seconds", "minutes" ],
                    "default": "seconds",
                    "desc": "time unit"
                }
            ]
        },
        {
            "filename": "wait_ms.u16.r_b_wait_done",
            "type": "wait",
            "description": "Wait milliseconds(simplified)",
            "duration": "${duration}",
            "unit": "ms",
            "args": [
                {
                    "index": 0,
                    "name": "duration",
                    "type": "u16",
                    "min": 1,
                    "max": 65535,
                    "desc": "wait milliseconds"
                }
            ]
        }
    ]
}