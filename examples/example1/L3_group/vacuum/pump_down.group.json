{
    "type": "group",
    "name": "Evacuation",
    "description": "Complete Evacuation flow: open V1 -> close V2 -> start pump -> loop check -> stop pump",
    "mode": "sequence",
    "max_nodes": 50,
    "timeout_ms": 360000,
    "body": [
        {
            "type": "node",
            "template": "L2_node/vacuum/all_nodes.json/open_valve.r_b_valve_open",
            "params": []
        },
        {
            "type": "node",
            "template": "L2_node/vacuum/all_nodes.json/close_valve.r_b_valve_close",
            "params": []
        },
        {
            "type": "node",
            "template": "L2_node/vacuum/all_nodes.json/start_pump.r_b_pump_start",
            "params": []
        },
        {
            "type": "group",
            "name": "Pressure monitor loop",
            "description": "do-while loop: run once, then continue while condition is true",
            "mode": "loop",
            "max_nodes": 20,
            "timeout_ms": 300000,
            "loop": {
                "type": "do-while",
                "condition": "${pressure} > 5"
            },
            "body": [
                {
                    "type": "node",
                    "template": "L2_node/vacuum/all_nodes.json/read_pressure.r_u16_pressure",
                    "params": []
                },
                {
                    "type": "node",
                    "template": "L2_node/control/all_nodes.json/wait.u16_s.r_b_wait_done",
                    "params": [ 500 ]
                }
            ],
            "on_success": [
                {
                    "type": "log",
                    "message": "Evacuationdone, pressure reached target"
                }
            ],
            "on_failure": [
                {
                    "type": "log",
                    "message": "Evacuationloop checkfailed"
                }
            ],
            "on_timeout": [
                {
                    "type": "log",
                    "message": "Evacuationtimeout (5 min)"
                },
                {
                    "type": "node",
                    "template": "L2_node/vacuum/all_nodes.json/stop_pump.r_b_pump_stop",
                    "params": []
                },
                {
                    "type": "node",
                    "template": "L2_node/system/all_nodes.json/popup.s_s",
                    "params": [ "Evacuationtimeout (5 min), emergency stopped", "error" ]
                }
            ]
        },
        {
            "type": "node",
            "template": "L2_node/vacuum/all_nodes.json/stop_pump.r_b_pump_stop",
            "params": []
        }
    ],
    "on_timeout": [
        {
            "type": "log",
            "message": "Evacuationgroup overall timeout (6 min)"
        },
        {
            "type": "node",
            "template": "L2_node/vacuum/all_nodes.json/stop_pump.r_b_pump_stop",
            "params": []
        },
        {
            "type": "popup",
            "message": "Evacuationflow overall timeout",
            "level": "error"
        }
    ]
}