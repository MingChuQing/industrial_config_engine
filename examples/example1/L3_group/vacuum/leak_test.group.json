{
    "type": "group",
    "name": "Leak Test",
    "description": "calculate leak rate and judge ",
    "mode": "sequence",
    "max_nodes": 30,
    "timeout_ms": 120000,
    "body": [
        {
            "type": "node",
            "template": "L2_node/vacuum/all_nodes.json/read_pressure.r_u16_pressure",
            "params": []
        },
        {
            "type": "node",
            "template": "L2_node/data/all_nodes.json/calculate.s.r_f_calc_result",
            "params": [ "(${initial_pressure} - ${hold_pressure}) / ${initial_pressure} * 100" ],
            "result_key": "leak_rate"
        },
        {
            "type": "group",
            "name": "Judge if leak rate is qualified",
            "mode": "if",
            "condition": {
                "type": "expression",
                "expression": "${leak_rate} <= 0.5"
            },
            "then": [
                {
                    "type": "log",
                    "message": "Leak Testqualified"
                },
                {
                    "type": "node",
                    "template": "L2_node/system/all_nodes.json/log.s",
                    "params": [ "Leak Testqualified, leak rate=${leak_rate}%" ]
                }
            ],
            "else": [
                {
                    "type": "log",
                    "message": "Leak Testunqualified"
                },
                {
                    "type": "node",
                    "template": "L2_node/system/all_nodes.json/popup.s_s",
                    "params": [ "Leak rate ${leak_rate}% exceeds 0.5% threshold", "error" ]
                }
            ]
        }
    ],
    "on_timeout": [
        {
            "type": "log",
            "message": "Leak Testtimeout"
        },
        {
            "type": "popup",
            "message": "Leak Testtimeout",
            "level": "error"
        }
    ]
}