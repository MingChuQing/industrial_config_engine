{
    "type": "group",
    "name": "泄漏检测",
    "description": "计算泄漏率并判断是否合格",
    "mode": "sequence",
    "max_nodes": 30,
    "timeout_ms": 120000,
    "body": [
        {
            "type": "node",
            "template": "L2_node/vacuum/all_nodes.json/read_pressure.r_u16_pressure",
            "params": []
        },
        {
            "type": "node",
            "template": "L2_node/data/all_nodes.json/calculate.s.r_f_calc_result",
            "params": [ "(${initial_pressure} - ${hold_pressure}) / ${initial_pressure} * 100" ],
            "result_key": "leak_rate"
        },
        {
            "type": "group",
            "name": "判断泄漏率是否合格",
            "mode": "if",
            "condition": {
                "type": "expression",
                "expression": "${leak_rate} <= 0.5"
            },
            "then": [
                {
                    "type": "log",
                    "message": "泄漏检测合格"
                },
                {
                    "type": "node",
                    "template": "L2_node/system/all_nodes.json/log.s",
                    "params": [ "泄漏检测合格，泄漏率=${leak_rate}%" ]
                }
            ],
            "else": [
                {
                    "type": "log",
                    "message": "泄漏检测不合格"
                },
                {
                    "type": "node",
                    "template": "L2_node/system/all_nodes.json/popup.s_s",
                    "params": [ "泄漏率${leak_rate}%，超过阈值0.5%", "error" ]
                }
            ]
        }
    ],
    "on_timeout": [
        {
            "type": "log",
            "message": "泄漏检测超时"
        },
        {
            "type": "popup",
            "message": "泄漏检测超时",
            "level": "error"
        }
    ]
}