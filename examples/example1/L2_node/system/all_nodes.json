{
    "type": "node_bundle",
    "description": "系统控制类执行节点集合",
    "version": "1.0.0",
    "nodes": [
        {
            "filename": "log.s",
            "type": "node",
            "name": "日志记录",
            "description": "记录日志信息",
            "params": ["message"],
            "timeout_ms": 2000,
            "max_retries": 0,
            "retry_interval": 0,
            "action": {
                "template": "L1_action/system/all_actions.json/log.s"
            },
            "judge": {
                "type": "exists"
            },
            "on_success": [],
            "on_failure": [],
            "on_timeout": [
                { "type": "log", "message": "日志记录超时" }
            ]
        },
        {
            "filename": "popup.s_s",
            "type": "node",
            "name": "弹窗提示",
            "description": "弹出提示对话框",
            "params": ["message", "level"],
            "timeout_ms": 3000,
            "max_retries": 0,
            "retry_interval": 0,
            "action": {
                "template": "L1_action/system/all_actions.json/popup.s_s"
            },
            "judge": {
                "type": "exists"
            },
            "on_success": [],
            "on_failure": [],
            "on_timeout": [
                { "type": "log", "message": "弹窗提示超时" },
                { "type": "popup", "message": "弹窗提示超时", "level": "error" }
            ]
        }
    ]
}