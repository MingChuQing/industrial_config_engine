{
    "type": "node_bundle",
    "description": "system control node collection",
    "version": "1.0.0",
    "nodes": [
        {
            "filename": "log.s",
            "type": "node",
            "name": "log record",
            "description": "record log message",
            "params": ["message"],
            "timeout_ms": 2000,
            "max_retries": 0,
            "retry_interval": 0,
            "action": {
                "template": "L1_action/system/all_actions.json/log.s"
            },
            "judge ": {
                "type": "exists"
            },
            "on_success": [],
            "on_failure": [],
            "on_timeout": [
                { "type": "log", "message": "log record timeout" }
            ]
        },
        {
            "filename": "popup.s_s",
            "type": "node",
            "name": "popup prompt",
            "description": "show prompt dialog",
            "params": ["message", "level"],
            "timeout_ms": 3000,
            "max_retries": 0,
            "retry_interval": 0,
            "action": {
                "template": "L1_action/system/all_actions.json/popup.s_s"
            },
            "judge ": {
                "type": "exists"
            },
            "on_success": [],
            "on_failure": [],
            "on_timeout": [
                { "type": "log", "message": "popup prompt timeout" },
                { "type": "popup", "message": "popup prompt timeout", "level": "error" }
            ]
        }
    ]
}