{
"type": "node_bundle",
"description": "Vacuum control node bundle",
"version": "1.0.0",
"nodes": [
{
"filename": "start_pump.r_b_pump_start",
"type": "node",
"name": "Start Pump",
"description": "send start command Start Pump",
"params": [],
"timeout_ms": 5000,
"max_retries": 3,
"retry_interval": 1000,
"action": {
"template": "L1_action/modbus/all_actions.json/write_register_fixed.r_b_pump_start"
},
"judge ": {
"type": "compare",
"condition": "eq",
"value": true
},
"on_success": [
{ "type": "log", "message": "Pump started" }
],
"on_failure": [
{ "type": "popup", "message": "Failed to start pump", "level": "error" }
],
"on_timeout": [
{ "type": "log", "message": "Start Pumptimeout" },
{ "type": "popup", "message": "Start Pumptimeout, check communication", "level": "error" }
]
},
{
"filename": "stop_pump.r_b_pump_stop",
"type": "node",
"name": "Stop Pump",
"description": "send stop command Stop Pump",
"params": [],
"timeout_ms": 3000,
"max_retries": 3,
"retry_interval": 500,
"action": {
"template": "L1_action/modbus/all_actions.json/write_register_fixed_stop.r_b_pump_stop"
},
"judge ": {
"type": "compare",
"condition": "eq",
"value": true
},
"on_success": [
{ "type": "log", "message": "Pump stopped" }
],
"on_failure": [
{ "type": "popup", "message": "Failed to stop pump", "level": "error" }
],
"on_timeout": [
{ "type": "log", "message": "Stop Pumptimeout" },
{ "type": "popup", "message": "Stop Pumptimeout, check communication", "level": "error" }
]
},
{
"filename": "read_pressure.r_u16_pressure",
"type": "node",
"name": "Read Pressure",
"description": "Read current pressure from the sensor",
"params": [1, 2000],
"timeout_ms": 3000,
"max_retries": 2,
"retry_interval": 500,
"action": {
"template": "L1_action/modbus/all_actions.json/read_register.u8_u16.r_u16_pressure"
},
"judge ": {
"type": "exists"
},
"on_success": [
{ "type": "log", "message": "Current pressure=${pressure}Pa" }
],
"on_failure": [
{ "type": "popup", "message": "Pressure read failed", "level": "error" }
],
"on_timeout": [
{ "type": "log", "message": "Read Pressuretimeout" },
{ "type": "popup", "message": "Pressure sensor communication timeout", "level": "error" }
]
},
{
"filename": "open_valve.r_b_valve_open",
"type": "node",
"name": "Open Valve",
"description": "Open the specified valve",
"params": [1],
"timeout_ms": 3000,
"max_retries": 3,
"retry_interval": 500,
"action": {
"template": "L1_action/modbus/all_actions.json/write_coil_on.r_b_coil_on_result"
},
"judge ": {
"type": "compare",
"condition": "eq",
"value": true
},
"on_success": [
{ "type": "log", "message": "Valve opened" }
],
"on_failure": [
{ "type": "popup", "message": "Failed to open valve", "level": "error" }
],
"on_timeout": [
{ "type": "log", "message": "Open Valvetimeout" },
{ "type": "popup", "message": "Open Valvetimeout, check communication", "level": "error" }
]
},
{
"filename": "close_valve.r_b_valve_close",
"type": "node",
"name": "Close Valve",
"description": "Close the specified valve",
"params": [2],
"timeout_ms": 3000,
"max_retries": 3,
"retry_interval": 500,
"action": {
"template": "L1_action/modbus/all_actions.json/write_coil_off.r_b_coil_off_result"
},
"judge ": {
"type": "compare",
"condition": "eq",
"value": true
},
"on_success": [
{ "type": "log", "message": "Valve closed" }
],
"on_failure": [
{ "type": "popup", "message": "Failed to close valve", "level": "error" }
],
"on_timeout": [
{ "type": "log", "message": "Close Valvetimeout" },
{ "type": "popup", "message": "Close Valvetimeout, check communication", "level": "error" }
]
}
]
}