{
    "type": "node_bundle",
    "description": "饮料灌装线 L2 执行节点",
    "nodes": [
        {
            "filename": "axis_home.u8.r_b_homed",
            "type": "node",
            "name": "轴回零",
            "params": [
                1
            ],
            "timeout_ms": 30000,
            "max_retries": 2,
            "action": {
                "template": "L1_action/all_actions.json/motor_home_mode.r_b_home_mode"
            },
            "on_failure": [
                {
                    "type": "popup",
                    "message": "轴回零失败",
                    "level": "error"
                }
            ],
            "on_success": []
        },
        {
            "filename": "axis_move_abs.u8_u32.r_b_arrived",
            "type": "node",
            "name": "轴绝对定位",
            "params": [
                1,
                0
            ],
            "timeout_ms": 30000,
            "max_retries": 2,
            "action": {
                "template": "L1_action/all_actions.json/motor_pr_abs.r_b_abs_done"
            },
            "on_failure": [
                {
                    "type": "popup",
                    "message": "轴绝对定位失败",
                    "level": "error"
                }
            ],
            "on_success": []
        },
        {
            "filename": "axis_alarm.u8.r_b_ok",
            "type": "node",
            "name": "轴报警检查",
            "params": [
                1
            ],
            "timeout_ms": 3000,
            "max_retries": 2,
            "action": {
                "template": "L1_action/all_actions.json/motor_alarm.r_u16_alarm"
            },
            "judge": {
                "type": "compare",
                "condition": "eq",
                "value": 0
            },
            "on_failure": [
                {
                    "type": "popup",
                    "message": "轴报警检查失败",
                    "level": "error"
                }
            ],
            "on_success": []
        },
        {
