{
    "type": "node_bundle",
    "description": "Beverage Filling line L2 execution nodes",
    "nodes": [
        {
            "filename": "axis_home.u8.r_b_homed",
            "type": "node",
            "name": "axis homing",
            "params": [
                1
            ],
            "timeout_ms": 30000,
            "max_retries": 2,
            "action": {
                "template": "L1_action/all_actions.json/motor_home_mode.r_b_home_mode"
            },
            "on_failure": [
                {
                    "type": "popup",
                    "message": "axis homingfailed",
                    "level": "error"
                }
            ],
            "on_success": []
        },
        {
            "filename": "axis_move_abs.u8_u32.r_b_arrived",
            "type": "node",
            "name": "axis absolute move",
            "params": [
                1,
                0
            ],
            "timeout_ms": 30000,
            "max_retries": 2,
            "action": {
                "template": "L1_action/all_actions.json/motor_pr_abs.r_b_abs_done"
            },
            "on_failure": [
                {
                    "type": "popup",
