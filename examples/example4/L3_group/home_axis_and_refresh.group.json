{
    "type": "group",
    "name": "Home axis and refresh",
    "mode": "sequence",
    "body": [
        {
            "type": "group",
            "template": "L3_group/move_axis_if_changed.group.json",
            "params": [
                "${home_state_key}",
                0,
                "${home_devices}"
            ]
        },
        {
            "type": "node",
            "template": "L2_node/all_nodes.json/wait_ms.u32.r_b_done",
            "params": [
                3000
            ]
        },
        {
            "type": "group",
            "template": "L3_group/refresh_all_motor_positions_and_ui.group.json",
            "params": []
        }
    ],
    "args": [
        {
            "index": 0,
            "name": "home_state_key",
            "type": "s"
        },
        {
            "index": 1,
            "name": "home_devices",
            "type": "arr"
        }
    ]
}
