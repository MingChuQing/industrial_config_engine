{
    "type": "group",
    "name": "System initialization",
    "mode": "sequence",
    "max_nodes": 200,
    "body": [
        {
            "type": "group",
            "template": "L3_group/home_axis_and_refresh.group.json",
            "params": [
                "last_x_pr",
                [
                    "X"
                ]
            ]
        },
        {
            "type": "group",
            "template": "L3_group/home_axis_and_refresh.group.json",
            "params": [
                "last_y_pr",
                [
                    "Y1",
                    "Y2"
                ]
            ]
        },
        {
            "type": "group",
            "template": "L3_group/home_axis_and_refresh.group.json",
            "params": [
                "last_z_pr",
                [
                    "Z"
                ]
            ]
        },
        {
            "type": "node",
            "template": "L2_node/all_nodes.json/write_050011.u16.r_b_done",
            "params": [
                0
            ],
            "device": "FillingValve"
        },
        {
            "type": "node",
            "template": "L2_node/all_nodes.json/write_050012.u16.r_b_done",
            "params": [
                0
            ],
            "device": "RinseValve"
        },
        {
            "type": "node",
            "template": "L2_node/all_nodes.json/write_050013.u16.r_b_done",
            "params": [
                0
            ],
            "device": "CIPValve"
        },
        {
            "type": "node",
            "template": "L2_node/all_nodes.json/write_050008.u16.r_b_done",
            "params": [
                0
            ],
            "device": "Relay"
        },
        {
            "type": "node",
            "template": "L2_node/all_nodes.json/write_050009.u16.r_b_done",
            "params": [
                0
            ],
            "device": "Relay"
        },
        {
            "type": "node",
            "template": "L2_node/all_nodes.json/write_05000a.u16.r_b_done",
            "params": [
                0
            ],
            "device": "Relay"
        },
        {
            "type": "node",
            "template": "L2_node/all_nodes.json/write_05000b.u16.r_b_done",
            "params": [
                0
            ],
            "device": "Relay"
        },
        {
            "type": "node",
            "template": "L2_node/all_nodes.json/write_05000c.u16.r_b_done",
            "params": [
                0
            ],
            "device": "Relay"
        },
        {
            "type": "node",
            "template": "L2_node/all_nodes.json/trigger_pr_path.u16.r_b_done",
            "params": [
                64
            ],
            "device": "Conveyor"
        },
        {
            "type": "node",
            "template": "L2_node/all_nodes.json/read_fc03_reg2203_x_alarm.r_b_check_ok",
            "params": [],
            "device": "X"
        },
        {
            "type": "node",
            "template": "L2_node/all_nodes.json/read_fc03_reg2203_y_alarm.r_b_check_ok",
            "params": [],
            "device": "Y1"
        },
        {
            "type": "node",
            "template": "L2_node/all_nodes.json/read_fc03_reg2203_y_alarm_y2.r_b_check_ok",
            "params": [],
            "device": "Y2"
        },
        {
            "type": "node",
            "template": "L2_node/all_nodes.json/read_fc03_reg2203_z_alarm.r_b_check_ok",
            "params": [],
            "device": "Z"
        },
        {
            "type": "node",
            "template": "L2_node/all_nodes.json/read_fc03_reg1003.r_u16_value",
            "params": [],
            "device": "X",
            "result_key": "xStatus"
        },
        {
            "type": "node",
            "template": "L2_node/all_nodes.json/read_fc03_reg1003.r_u16_value",
            "params": [],
            "device": "Y1",
            "result_key": "yStatus"
        },
        {
            "type": "node",
            "template": "L2_node/all_nodes.json/read_fc03_reg1003.r_u16_value",
            "params": [],
            "device": "Y2",
            "result_key": "yStatus_Y2"
        },
        {
            "type": "node",
            "template": "L2_node/all_nodes.json/read_fc03_reg1003.r_u16_value",
            "params": [],
            "device": "Z",
            "result_key": "zStatus"
        },
        {
            "type": "node",
            "template": "L2_node/all_nodes.json/update_ui.s_s",
            "params": [
                "SystemState",
                "ready"
            ]
        },
        {
            "type": "node",
            "template": "L2_node/all_nodes.json/wait_ms.u32.r_b_done",
            "params": [
                1000
            ]
        }
    ]
}
