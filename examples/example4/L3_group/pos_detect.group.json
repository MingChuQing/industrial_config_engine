{
    "type": "group",
    "name": "Four-station bottle detection",
    "mode": "loop",
    "timeout_ms": 60000,
    "args": [
        {
            "index": 0,
            "name": "sensor",
            "type": "u16"
        }
    ],
    "body": [
        {
            "type": "node",
            "template": "L2_node/all_nodes.json/sensor_wait.u16_u16.r_b_triggered",
            "params": [
                "${sensor}",
                3000
            ]
        }
    ]
}