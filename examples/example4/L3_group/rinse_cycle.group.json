{
    "type": "group",
    "name": "阀控循环(开-计时-关)",
    "mode": "sequence",
    "timeout_ms": 60000,
    "args": [
        {
            "index": 0,
            "name": "coil",
            "type": "u16"
        },
        {
            "index": 1,
            "name": "ms",
            "type": "u16"
        }
    ],
    "body": [
        {
            "type": "node",
            "template": "L2_node/all_nodes.json/coil_set.u16_b.r_b_done",
            "params": [
                "${coil}",
                true
            ]
        },
        {
            "type": "node",
            "template": "L2_node/all_nodes.json/wait_ms.u16.r_b_wait_done",
            "params": [
                "${ms}"
            ]
        },
        {
            "type": "node",
            "template": "L2_node/all_nodes.json/coil_set.u16_b.r_b_done",
            "params": [
                "${coil}",
                false
            ]
        }
    ]
}