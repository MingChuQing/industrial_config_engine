{
    "type": "group",
    "name": "Move three axes to station",
    "mode": "sequence",
    "timeout_ms": 60000,
    "args": [
        {
            "index": 0,
            "name": "x",
            "type": "u32"
        },
        {
            "index": 1,
            "name": "y",
            "type": "u32"
        },
        {
            "index": 2,
            "name": "z",
            "type": "u32"
        }
    ],
    "body": [
        {
            "type": "node",
            "template": "L2_node/all_nodes.json/axis_move_abs.u8_u32.r_b_arrived",
            "params": [
                1,
                "${x}"
            ]
        },
        {
            "type": "node",
            "template": "L2_node/all_nodes.json/axis_move_abs.u8_u32.r_b_arrived",
            "params": [
                2,
                "${y}"
            ]
        },
        {
            "type": "node",
            "template": "L2_node/all_nodes.json/axis_move_abs.u8_u32.r_b_arrived",
            "params": [
                3,
                "${z}"
            ]
        }
    ]
}