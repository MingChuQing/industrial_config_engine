{
    "type": "action_bundle",
    "description": "Beverage Filling line L1 atomic actions(iDM-RS stepper + Modbus device)",
    "actions": [
        {
            "filename": "motor_enable.r_b_enable_done",
            "type": "modbus_write_verify",
            "request": "06 18 01 00 01"
        },
        {
            "filename": "motor_pr_abs.r_b_abs_done",
            "type": "modbus_write_verify",
            "request": "06 62 00 00 01",
            "remark": "PR0=absolute position"
        },
        {
            "filename": "motor_pos_h.u16.r_b_pos_h",
            "type": "modbus_write_verify",
            "request": "06 62 01 ${hi_high} ${hi_low}",
            "args": [
                {
                    "name": "hi",
                    "type": "u16"
                }
            ]
        },
        {
            "filename": "motor_pos_l.u16.r_b_pos_l",
            "type": "modbus_write_verify",
            "request": "06 62 02 ${lo_high} ${lo_low}",
            "args": [
                {
                    "name": "lo",
                    "type": "u16"
                }
            ]
        },
        {
            "filename": "motor_speed.u16.r_b_speed",
            "type": "modbus_write_verify",
            "request": "06 62 03 ${sp_high} ${sp_low}",
            "args": [
                {
                    "name": "speed",
                    "type": "u16"
                }
            ]
        },
        {
            "filename": "motor_trigger.r_b_trigger_done",
            "type": "modbus_write_verify",
            "request": "06 60 02 00 10",
            "remark": "trigger path 0"
        },
        {
            "filename": "motor_home_mode.r_b_home_mode",
            "type": "modbus_write_verify",
            "request": "06 60 0A 00 02",
            "remark": "limit homing"
        },
        {
            "filename": "motor_home_trigger.r_b_home_done",
            "type": "modbus_write_verify",
            "request": "06 60 02 00 20",
            "remark": "trigger homing"
        },
        {
            "filename": "motor_status.r_u16_status",
            "type": "modbus_read_cache",
            "request": "03 10 03 00 01",
            "parse": {
                "start_byte": 2,
                "length": 2,
                "endian": "big",
                "type": "uint16"
            }
        },
        {
            "filename": "motor_alarm.r_u16_alarm",
            "type": "modbus_read_cache",
            "request": "03 22 03 00 01",
            "parse": {
                "start_byte": 2,
                "length": 2,
                "endian": "big",
                "type": "uint16"
            }
        },
        {
            "filename": "conveyor_speed_mode.r_b_speed_mode",
            "type": "modbus_write_verify",
            "request": "06 62 00 00 02",
            "remark": "PR0=speed mode"
        },
        {
            "filename": "conveyor_speed.u16.r_b_speed",
            "type": "modbus_write_verify",
            "request": "06 62 03 ${sp_high} ${sp_low}",
            "args": [
                {
                    "name": "speed",
                    "type": "u16"
                }
            ]
        },
        {
            "filename": "conveyor_trigger.r_b_run_done",
            "type": "modbus_write_verify",
            "request": "06 60 02 00 10"
        },
        {
            "filename": "conveyor_stop.r_b_stop_done",
            "type": "modbus_write_verify",
            "request": "06 60 02 00 40",
            "remark": "emergency stop"
        },
        {
            "filename": "coil_write.u16_b.r_b_done",
            "type": "modbus_write_verify",
            "request": "05 ${coil_high} ${coil_low} ${val}",
            "args": [
                {
                    "name": "coil",
                    "type": "u16"
                },
                {
                    "name": "on",
                    "type": "b"
                }
            ]
        },
        {
            "filename": "di_read.u16.r_b_triggered",
            "type": "modbus_read_cache",
            "request": "04 ${addr_high} ${addr_low} 00 01",
            "parse": {
                "start_byte": 2,
                "length": 1,
                "endian": "big",
                "type": "uint16"
            },
            "args": [
                {
                    "name": "addr",
                    "type": "u16"
                }
            ]
        },
        {
            "filename": "reg_read_float.u16.r_f_value",
            "type": "modbus_read_cache",
            "request": "03 ${reg_high} ${reg_low} 00 02",
            "parse": {
                "start_byte": 2,
                "length": 4,
                "endian": "little",
                "type": "float"
            },
            "args": [
                {
                    "name": "reg",
                    "type": "u16"
                }
            ]
        },
        {
            "filename": "reg_write.u16_u16.r_b_done",
            "type": "modbus_write_verify",
            "request": "06 ${reg_high} ${reg_low} ${val_high} ${val_low}",
            "args": [
                {
                    "name": "reg",
                    "type": "u16"
                },
                {
                    "name": "value",
                    "type": "u16"
                }
            ]
        },
        {
            "filename": "wait.u16.r_b_wait_done",
            "type": "wait",
            "args": [
                {
                    "name": "ms",
                    "type": "u16"
                }
            ]
        },
        {
            "filename": "popup.s_s",
            "type": "popup",
            "args": [
                {
                    "name": "message",
                    "type": "s"
                },
                {
                    "name": "level",
                    "type": "s"
                }
            ]
        },
        {
            "filename": "log.s",
            "type": "log",
            "args": [
                {
                    "name": "message",
                    "type": "s"
                }
            ]
        }
    ]
}