{
    "type": "group",
    "name": "Full feeding flow",
    "description": "Write PR coords -> home -> PR1 precise -> PR2 precise",
    "mode": "sequence",
    "max_nodes": 50,
    "timeout_ms": 180000,
    "args": [
        { "index": 0, "name": "pr1_position", "type": "i32", "default": 50000, "desc": "PR1 position (pulse)" },
        { "index": 1, "name": "pr2_position", "type": "i32", "default": 100000, "desc": "PR2 position (pulse)" },
        { "index": 2, "name": "sensor_register", "type": "u8", "default": 512, "desc": "photoelectric switchregister" }
    ],
    "body": [
        {
            "type": "group",
            "template": "L3_group/write_pr_position.group.json",
            "params": [0, 0]
        },
        {
            "type": "group",
            "template": "L3_group/write_pr_position.group.json",
            "params": [1, "${pr1_position}"]
        },
        {
            "type": "group",
            "template": "L3_group/write_pr_position.group.json",
            "params": [2, "${pr2_position}"]
        },
        {
            "type": "group",
            "template": "L3_group/run_pr_with_wait.group.json",
            "params": [0, 10000]
        },
        {
            "type": "group",
            "template": "L3_group/precise_positioning.group.json",
            "params": [1, "${sensor_register}", "position_1", 30000]
        },
        {
            "type": "group",
            "template": "L3_group/precise_positioning.group.json",
            "params": [2, "${sensor_register}", "position_2", 30000]
        },
        {
            "type": "node",
            "template": "L2_node/ui_nodes.json/popup.s_s",
            "params": ["Feeding done! pos1=${position_1}, pos2=${position_2}", "success"]
        }
    ],
    "on_timeout": [
        { "type": "log", "message": "Full feeding flowtimeout" },
        { "type": "popup", "message": "Feeding timeout, check system", "level": "error" }
    ]
}