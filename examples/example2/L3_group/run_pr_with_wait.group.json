{
    "type": "group",
    "name": "Run PR and wait",
    "description": "Start PR, loop until motion done",
    "mode": "sequence",
    "max_nodes": 50,
    "timeout_ms": 60000,
    "args": [
        { "index": 0, "name": "pr_number", "type": "u8", "desc": "PR point number" },
        { "index": 1, "name": "timeout", "type": "u16", "default": 30000, "desc": "timeout(ms)" }
    ],
    "body": [
        {
            "type": "node",
            "template": "L2_node/leadshine_nodes.json/start_pr_run.u8.r_b_start_result",
            "params": ["${pr_number}"]
        },
        {
            "type": "group",
            "name": "Loop wait motion done",
            "mode": "loop",
            "max_nodes": 20,
            "timeout_ms": "${timeout}",
            "loop": {
                "type": "do-while",
                "condition": "${motion_done} != true"
            },
            "body": [
                {
                    "type": "node",
                    "template": "L2_node/leadshine_nodes.json/check_motion_done.r_b_motion_done",
                    "params": []
                },
                {
                    "type": "node",
                    "template": "L2_node/wait_nodes.json/wait_ms.u16.r_b_wait_done",
                    "params": [100]
                }
            ],
            "on_success": [
                { "type": "log", "message": "PR${pr_number} run done" }
            ],
            "on_timeout": [
                { "type": "log", "message": "PR${pr_number} run timeout" },
                { "type": "popup", "message": "PR${pr_number} run timeout, , check motor", "level": "error" }
            ]
        }
    ],
    "on_timeout": [
        { "type": "log", "message": "PR${pr_number} group timeout" },
        { "type": "popup", "message": "PR${pr_number} group timeout", "level": "error" }
    ]
}