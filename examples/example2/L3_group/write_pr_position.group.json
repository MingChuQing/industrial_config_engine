{
    "type": "group",
    "name": "Write and verify PR point",
    "description": "Write PR coords and verify",
    "mode": "sequence",
    "max_nodes": 20,
    "timeout_ms": 30000,
    "args": [
        { "index": 0, "name": "pr_number", "type": "u8", "desc": "PR point number" },
        { "index": 1, "name": "position", "type": "i32", "desc": "target position (pulse count)" }
    ],
    "body": [
        {
            "type": "node",
            "template": "L2_node/leadshine_nodes.json/write_pr_position.u8_i32.r_b_write_pr_result",
            "params": ["${pr_number}", "${position}"]
        },
        {
            "type": "node",
            "template": "L2_node/leadshine_nodes.json/verify_pr_position.u8_i32.r_b_verify_result",
            "params": ["${pr_number}", "${position}"]
        }
    ],
    "on_timeout": [
        { "type": "log", "message": "Write/verify PR${pr_number} timeout" },
        { "type": "popup", "message": "Write/verify PR${pr_number} timeout", "level": "error" }
    ]
}