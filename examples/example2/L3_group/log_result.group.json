{
    "type": "group",
    "name": "Result Log",
    "description": "Log process execution result",
    "mode": "sequence",
    "max_nodes": 10,
    "timeout_ms": 10000,
    "body": [
        {
            "type": "node",
            "template": "L2_node/system_nodes.json/log.s",
            "params": ["Process done, target=${profile.vacuum_target}Pa, final=${hold_pressure}Pa, leak=${leak_rate}%"]
        },
        {
            "type": "node",
            "template": "L2_node/system_nodes.json/popup.s_s",
            "params": ["Vacuum Process Flowexecution done", "success"]
        }
    ],
    "on_timeout": [
        { "type": "log", "message": "Result Logtimeout" }
    ]
}