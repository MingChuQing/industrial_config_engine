{
    "type": "group",
    "name": "泄漏检测",
    "description": "计算泄漏率并判断是否合格",
    "mode": "sequence",
    "max_nodes": 30,
    "timeout_ms": 120000,
    "body": [
        {
            "type": "node",
            "template": "L2_node/vacuum_nodes.json/read_pressure.r_u16_pressure",
            "params": []
        },
        {
            "type": "node",
            "template": "L2_node/data_nodes.json/calculate.s.r_f_calc_result",
            "params": ["(${initial_pressure} - ${hold_pressure}) / ${initial_pressure} * 100"]
        },
        {
            "type": "group",
            "name": "判断泄漏率是否合格",
            "mode": "if",
            "max_nodes": 10,
            "timeout_ms": 10000,
            "condition": {
                "type": "expression",
                "expression": "${leak_rate} <= 0.5"
            },
            "then": [
                { "type": "log", "message": "泄漏检测合格" },
                {
                    "type": "node",
                    "template": "L2_node/system_nodes.json/log.s",
                    "params": ["泄漏检测合格，泄漏率=${leak_rate}%"]
                }
            ],
            "else": [
                { "type": "log", "message": "泄漏检测不合格" },
                {
                    "type": "node",
                    "template": "L2_node/system_nodes.json/popup.s_s",
                    "params": ["泄漏率${leak_rate}%，超过阈值0.5%", "error"]
                }
            ],
            "on_timeout": [
                { "type": "log", "message": "判断泄漏率超时" }
            ]
        }
    ],
    "on_timeout": [
        { "type": "log", "message": "泄漏检测超时" },
        { "type": "popup", "message": "泄漏检测超时", "level": "error" }
    ]
}