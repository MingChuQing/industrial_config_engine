{
    "type": "group",
    "name": "紧急停止",
    "description": "紧急停止所有设备",
    "mode": "parallel",
    "max_nodes": 20,
    "timeout_ms": 10000,
    "body": [
        {
            "type": "node",
            "template": "L2_node/vacuum_nodes.json/stop_pump.r_b_pump_stop",
            "params": []
        },
        {
            "type": "node",
            "template": "L2_node/vacuum_nodes.json/close_valve.r_b_valve_close",
            "params": []
        }
    ],
    "on_timeout": [
        { "type": "log", "message": "[EMERGENCY] 紧急停止超时" }
    ]
}