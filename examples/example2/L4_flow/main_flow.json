{
    "type": "flow",
    "name": "真空工艺主流程",
    "description": "完整的真空工艺流程：系统自检 → 抽真空 → 保压 → 泄漏检测 → 结果记录",
    "mode": "sequence",
    "max_nodes": 50,
    "timeout_ms": 600000,
    "body": [
        {
            "type": "group",
            "template": "L3_group/system_check.group.json",
            "params": []
        },
        {
            "type": "group",
            "template": "L3_group/pump_down.group.json",
            "params": []
        },
        {
            "type": "group",
            "template": "L3_group/hold_pressure.group.json",
            "params": []
        },
        {
            "type": "group",
            "template": "L3_group/leak_test.group.json",
            "params": []
        },
        {
            "type": "group",
            "template": "L3_group/log_result.group.json",
            "params": []
        }
    ],
    "on_timeout": [
        { "type": "log", "message": "主流程超时" },
        { "type": "popup", "message": "真空工艺主流程执行超时", "level": "error" }
    ]
}