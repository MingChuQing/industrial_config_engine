{
    "type": "flow",
    "name": "Vacuum Process Main Flow",
    "description": "Complete Vacuum Process Flow: System Check -> Evacuation -> pressure hold -> Leak Test -> Result Log",
    "mode": "sequence",
    "max_nodes": 50,
    "timeout_ms": 600000,
    "body": [
        {
            "type": "group",
            "template": "L3_group/system_check.group.json",
            "params": []
        },
        {
            "type": "group",
            "template": "L3_group/pump_down.group.json",
            "params": []
        },
        {
            "type": "group",
            "template": "L3_group/hold_pressure.group.json",
            "params": []
        },
        {
            "type": "group",
            "template": "L3_group/leak_test.group.json",
            "params": []
        },
        {
            "type": "group",
            "template": "L3_group/log_result.group.json",
            "params": []
        }
    ],
    "on_timeout": [
        { "type": "log", "message": "Main flow timeout" },
        { "type": "popup", "message": "Vacuum Process Main Flowexecution timeout", "level": "error" }
    ]
}