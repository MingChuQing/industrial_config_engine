{
    "type": "node_bundle",
    "description": " 电机控制类执行节点集合",
    "version": "1.0.0",
    "nodes": [
        {
            "filename": "write_pr_position.u8_i32.r_b_write_pr_result",
            "type": "node",
            "name": "写入PR点位坐标",
            "description": "写入指定PR点位的坐标值",
            "params": [2, 100000],
            "timeout_ms": 10000,
            "max_retries": 3,
            "retry_interval": 500,
            "action": {
                "template": "L1_action/leadshine_actions.json/write_pr_position.u8_i32.r_b_write_pr_result"
            },
            "judge": {
                "type": "exists"
            },
            "on_success": [
                {
                    "type": "log",
                    "message": "PR${param_0}坐标写入成功"
                }
            ],
            "on_failure": [
                {
                    "type": "log",
                    "message": "PR${param_0}坐标写入失败"
                },
                {
                    "type": "popup",
                    "message": "PR${param_0}坐标写入失败，请检查通信",
                    "level": "error"
                }
            ],
            "on_timeout": [
                {
                    "type": "log",
                    "message": "PR${param_0}坐标写入超时"
                }
            ]
        },
        {
            "filename": "verify_pr_position.u8_i32.r_b_verify_result",
            "type": "node",
            "name": "验证PR点位坐标",
            "description": "读取PR点位坐标并验证是否与期望值一致",
            "params": [2, 100000],
            "timeout_ms": 5000,
            "max_retries": 0,
            "retry_interval": 0,
            "action": {
                "template": "L1_action/leadshine_actions.json/read_pr_position.u8.r_i32_pr_position"
            },
            "judge": {
                "type": "compare",
                "condition": "eq",
                "value": "${param_1}"
            },
            "on_success": [
                {
                    "type": "log",
                    "message": "PR${param_0}坐标验证通过：${pr_position}"
                }
            ],
            "on_failure": [
                {
                    "type": "log",
                    "message": "PR${param_0}坐标验证失败：期望${param_1}，实际${pr_position}"
                },
                {
                    "type": "popup",
                    "message": "PR${param_0}坐标验证失败",
                    "level": "error"
                }
            ],
            "on_timeout": [
                {
                    "type": "log",
                    "message": "PR${param_0}坐标验证超时"
                }
            ]
        },
        {
            "filename": "start_pr_run.u8.r_b_start_result",
            "type": "node",
            "name": "启动PR点位运行",
            "description": "触发PR点位运行指令",
            "params": [1],
            "timeout_ms": 5000,
            "max_retries": 2,
            "retry_interval": 1000,
            "action": {
                "template": "L1_action/leadshine_actions.json/pr_run.u8.r_b_pr_run_result"
            },
            "judge": {
                "type": "exists"
            },
            "on_success": [
                {
                    "type": "log",
                    "message": "PR${param_0}启动成功"
                }
            ],
            "on_failure": [
                {
                    "type": "log",
                    "message": "PR${param_0}启动失败"
                },
                {
                    "type": "popup",
                    "message": "PR${param_0}启动失败，请检查通信",
                    "level": "error"
                }
            ],
            "on_timeout": [
                {
                    "type": "log",
                    "message": "PR${param_0}启动超时"
                }
            ]
        },
        {
            "filename": "check_motion_done.r_b_motion_done",
            "type": "node",
            "name": "检查运动完成",
            "description": "检查电机运动状态是否完成",
            "params": [],
            "timeout_ms": 2000,
            "max_retries": 3,
            "retry_interval": 100,
            "action": {
                "template": "L1_action/leadshine_actions.json/check_motion_done.r_b_motion_done"
            },
            "judge": {
                "type": "compare",
                "condition": "eq",
                "value": true
            },
            "on_success": [
                {
                    "type": "log",
                    "message": "电机运动完成"
                }
            ],
            "on_failure": [
                {
                    "type": "log",
                    "message": "电机运动未完成或超时"
                }
            ],
            "on_timeout": [
                {
                    "type": "log",
                    "message": "检查运动完成超时"
                }
            ]
        },
        {
            "filename": "start_jog.u16.r_b_jog_start_result",
            "type": "node",
            "name": "启动点动",
            "description": "启动正向点动",
            "params": [10],
            "timeout_ms": 5000,
            "max_retries": 2,
            "retry_interval": 500,
            "action": {
                "template": "L1_action/leadshine_actions.json/jog_start.u16.r_b_jog_start_result"
            },
            "judge": {
                "type": "exists"
            },
            "on_success": [
                {
                    "type": "log",
                    "message": "点动启动成功，速度：${param_0}%"
                }
            ],
            "on_failure": [
                {
                    "type": "log",
                    "message": "点动启动失败"
                },
                {
                    "type": "popup",
                    "message": "点动启动失败，请检查电机",
                    "level": "error"
                }
            ],
            "on_timeout": [
                {
                    "type": "log",
                    "message": "点动启动超时"
                }
            ]
        },
        {
            "filename": "stop_jog.r_b_jog_stop_result",
            "type": "node",
            "name": "停止点动",
            "description": "立即停止点动",
            "params": [],
            "timeout_ms": 3000,
            "max_retries": 0,
            "retry_interval": 0,
            "action": {
                "template": "L1_action/leadshine_actions.json/jog_stop.r_b_jog_stop_result"
            },
            "judge": {
                "type": "exists"
            },
            "on_success": [
                {
                    "type": "log",
                    "message": "点动已停止"
                }
            ],
            "on_failure": [
                {
                    "type": "log",
                    "message": "停止点动失败"
                }
            ],
            "on_timeout": [
                {
                    "type": "log",
                    "message": "停止点动超时"
                }
            ]
        },
        {
            "filename": "read_current_position.r_i32_current_position",
            "type": "node",
            "name": "读取当前位置",
            "description": "读取电机当前绝对位置",
            "params": [],
            "timeout_ms": 3000,
            "max_retries": 0,
            "retry_interval": 0,
            "action": {
                "template": "L1_action/leadshine_actions.json/read_current_position.r_i32_current_position"
            },
            "judge": {
                "type": "exists"
            },
            "on_success": [
                {
                    "type": "log",
                    "message": "当前位置：${current_position}"
                }
            ],
            "on_failure": [
                {
                    "type": "log",
                    "message": "读取当前位置失败"
                },
                {
                    "type": "popup",
                    "message": "读取当前位置失败",
                    "level": "error"
                }
            ],
            "on_timeout": [
                {
                    "type": "log",
                    "message": "读取当前位置超时"
                }
            ]
        }
    ]
}