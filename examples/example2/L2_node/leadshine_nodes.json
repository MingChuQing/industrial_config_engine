{
    "type": "node_bundle",
    "description": " motor control node collection",
    "version": "1.0.0",
    "nodes": [
        {
            "filename": "write_pr_position.u8_i32.r_b_write_pr_result",
            "type": "node",
            "name": "write PR point coordinate",
            "description": "write coordinate of specified PR point",
            "params": [2, 100000],
            "timeout_ms": 10000,
            "max_retries": 3,
            "retry_interval": 500,
            "action": {
                "template": "L1_action/leadshine_actions.json/write_pr_position.u8_i32.r_b_write_pr_result"
            },
            "judge ": {
                "type": "exists"
            },
            "on_success": [
                {
                    "type": "log",
                    "message": "PR${param_0}coordinate write success"
                }
            ],
            "on_failure": [
                {
                    "type": "log",
                    "message": "PR${param_0}coordinate write failed"
                },
                {
                    "type": "popup",
                    "message": "PR${param_0}coordinatewrite failed, check communication",
                    "level": "error"
                }
            ],
            "on_timeout": [
                {
                    "type": "log",
                    "message": "PR${param_0}coordinate write timeout"
                }
            ]
        },
        {
            "filename": "verify_pr_position.u8_i32.r_b_verify_result",
            "type": "node",
            "name": "verify PR point coordinate",
            "description": "read PR point coordinateand verify consistency with expected value",
            "params": [2, 100000],
            "timeout_ms": 5000,
            "max_retries": 0,
            "retry_interval": 0,
            "action": {
                "template": "L1_action/leadshine_actions.json/read_pr_position.u8.r_i32_pr_position"
            },
            "judge ": {
                "type": "compare",
                "condition": "eq",
                "value": "${param_1}"
            },
            "on_success": [
                {
                    "type": "log",
                    "message": "PR${param_0}coordinate verify passed: ${pr_position}"
                }
            ],
            "on_failure": [
                {
                    "type": "log",
                    "message": "PR${param_0}coordinate verify failed: expected${param_1}, actual${pr_position}"
                },
                {
                    "type": "popup",
                    "message": "PR${param_0}coordinate verify failed",
                    "level": "error"
                }
            ],
            "on_timeout": [
                {
                    "type": "log",
                    "message": "PR${param_0}coordinate verify timeout"
                }
            ]
        },
        {
            "filename": "start_pr_run.u8.r_b_start_result",
            "type": "node",
            "name": "start PR point run",
            "description": "trigger PR point runcommand",
            "params": [1],
            "timeout_ms": 5000,
            "max_retries": 2,
            "retry_interval": 1000,
            "action": {
                "template": "L1_action/leadshine_actions.json/pr_run.u8.r_b_pr_run_result"
            },
            "judge ": {
                "type": "exists"
            },
            "on_success": [
                {
                    "type": "log",
                    "message": "PR${param_0}start success"
                }
            ],
            "on_failure": [
                {
                    "type": "log",
                    "message": "PR${param_0}start failed"
                },
                {
                    "type": "popup",
                    "message": "PR${param_0} start failed, check communication",
                    "level": "error"
                }
            ],
            "on_timeout": [
                {
                    "type": "log",
                    "message": "PR${param_0}start timeout"
                }
            ]
        },
        {
            "filename": "check_motion_done.r_b_motion_done",
            "type": "node",
            "name": "check motion done",
            "description": "check if motor motion done",
            "params": [],
            "timeout_ms": 2000,
            "max_retries": 3,
            "retry_interval": 100,
            "action": {
                "template": "L1_action/leadshine_actions.json/check_motion_done.r_b_motion_done"
            },
            "judge ": {
                "type": "compare",
                "condition": "eq",
                "value": true
            },
            "on_success": [
                {
                    "type": "log",
                    "message": "motor motion done"
                }
            ],
            "on_failure": [
                {
                    "type": "log",
                    "message": "motor motion not done or timeout"
                }
            ],
            "on_timeout": [
                {
                    "type": "log",
                    "message": "check motion done timeout"
                }
            ]
        },
        {
            "filename": "start_jog.u16.r_b_jog_start_result",
            "type": "node",
            "name": "start jog",
            "description": "start forward jog",
            "params": [10],
            "timeout_ms": 5000,
            "max_retries": 2,
            "retry_interval": 500,
            "action": {
                "template": "L1_action/leadshine_actions.json/jog_start.u16.r_b_jog_start_result"
            },
            "judge ": {
                "type": "exists"
            },
            "on_success": [
                {
                    "type": "log",
                    "message": "jog started, speed: ${param_0}%"
                }
            ],
            "on_failure": [
                {
                    "type": "log",
                    "message": "jogstart failed"
                },
                {
                    "type": "popup",
                    "message": "jog startfailed, check motor",
                    "level": "error"
                }
            ],
            "on_timeout": [
                {
                    "type": "log",
                    "message": "jogstart timeout"
                }
            ]
        },
        {
            "filename": "stop_jog.r_b_jog_stop_result",
            "type": "node",
            "name": "stop jog",
            "description": "immediately stop jog",
            "params": [],
            "timeout_ms": 3000,
            "max_retries": 0,
            "retry_interval": 0,
            "action": {
                "template": "L1_action/leadshine_actions.json/jog_stop.r_b_jog_stop_result"
            },
            "judge ": {
                "type": "exists"
            },
            "on_success": [
                {
                    "type": "log",
                    "message": "jogstopped"
                }
            ],
            "on_failure": [
                {
                    "type": "log",
                    "message": "stop jog failed"
                }
            ],
            "on_timeout": [
                {
                    "type": "log",
                    "message": "stop jog timeout"
                }
            ]
        },
        {
            "filename": "read_current_position.r_i32_current_position",
            "type": "node",
            "name": "read current position",
            "description": "read motorcurrent absolute position",
            "params": [],
            "timeout_ms": 3000,
            "max_retries": 0,
            "retry_interval": 0,
            "action": {
                "template": "L1_action/leadshine_actions.json/read_current_position.r_i32_current_position"
            },
            "judge ": {
                "type": "exists"
            },
            "on_success": [
                {
                    "type": "log",
                    "message": "current position: ${current_position}"
                }
            ],
            "on_failure": [
                {
                    "type": "log",
                    "message": "read current positionfailed"
                },
                {
                    "type": "popup",
                    "message": "read current positionfailed",
                    "level": "error"
                }
            ],
            "on_timeout": [
                {
                    "type": "log",
                    "message": "read current positiontimeout"
                }
            ]
        }
    ]
}