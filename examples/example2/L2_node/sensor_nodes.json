{
    "type": "node_bundle",
    "description": "sensor node collection",
    "version": "1.0.0",
    "nodes": [
        {
            "filename": "check_sensor_triggered.u8.r_b_sensor_triggered",
            "type": "node",
            "name": "Check sensor trigger",
            "description": "Read sensor state, judge  triggered (value 1)",
            "params": [512],
            "timeout_ms": 2000,
            "max_retries": 0,
            "retry_interval": 0,
            "action": {
                "template": "L1_action/leadshine_actions.json/read_sensor.u8.r_u16_sensor_value"
            },
            "judge ": {
                "type": "compare",
                "condition": "eq",
                "value": 1
            },
            "on_success": [
                {
                    "type": "log",
                    "message": "Sensor triggered, value: ${sensor_value}"
                }
            ],
            "on_failure": [
                {
                    "type": "log",
                    "message": "Sensor not triggered, value: ${sensor_value}"
                }
            ],
            "on_timeout": [
                {
                    "type": "log",
                    "message": "Sensor check timeout"
                }
            ]
        },
        {
            "filename": "read_sensor_value.u8.r_u16_sensor_value",
            "type": "node",
            "name": "Read sensor value",
            "description": "Read current sensor value",
            "params": [512],
            "timeout_ms": 2000,
            "max_retries": 0,
            "retry_interval": 0,
            "action": {
                "template": "L1_action/leadshine_actions.json/read_sensor.u8.r_u16_sensor_value"
            },
            "judge ": {
                "type": "exists"
            },
            "on_success": [
                {
                    "type": "log",
                    "message": "Sensor value: ${sensor_value}"
                }
            ],
            "on_failure": [
                {
                    "type": "log",
                    "message": "Failed to read sensor"
                }
            ],
            "on_timeout": [
                {
                    "type": "log",
                    "message": "read photoelectric switch timeout"
                }
            ]
        }
    ]
}