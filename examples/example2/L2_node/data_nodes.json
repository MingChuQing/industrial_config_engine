{
    "type": "node_bundle",
    "description": "data computation node collection",
    "version": "1.0.0",
    "nodes": [
        {
            "filename": "calculate.s.r_f_calc_result",
            "type": "node",
            "name": "calculate expression",
            "description": "calculate math expression and return float",
            "params": ["0"],
            "timeout_ms": 5000,
            "max_retries": 0,
            "retry_interval": 0,
            "action": {
                "template": "L1_action/data_actions.json/calculate.s.r_f_calc_result"
            },
            "judge ": {
                "type": "exists"
            },
            "on_success": [
                {
                    "type": "log",
                    "message": "calculate result: ${calc_result}"
                }
            ],
            "on_failure": [
                {
                    "type": "log",
                    "message": "calculate failed"
                }
            ],
            "on_timeout": [
                {
                    "type": "log",
                    "message": "calculate timeout"
                }
            ]
        }
    ]
}