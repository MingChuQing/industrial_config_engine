{
    "type": "node_bundle",
    "description": "wait node collection",
    "version": "1.0.0",
    "nodes": [
        {
            "filename": "wait_ms.u16.r_b_wait_done",
            "type": "node",
            "name": "Wait milliseconds",
            "description": "Wait milliseconds",
            "params": [100],
            "timeout_ms": 10000,
            "max_retries": 0,
            "retry_interval": 0,
            "action": {
                "template": "L1_action/control_actions.json/wait.u16.r_b_wait_done"
            },
            "judge ": {
                "type": "exists"
            },
            "on_success": [
                {
                    "type": "log",
                    "message": "Wait ${param_0}ms done"
                }
            ],
            "on_failure": [
                {
                    "type": "log",
                    "message": "Wait failed"
                }
            ],
            "on_timeout": [
                {
                    "type": "log",
                    "message": "Wait timeout"
                }
            ]
        },
        {
            "filename": "wait_seconds.u16.r_b_wait_done",
            "type": "node",
            "name": "Wait seconds",
            "description": "Wait seconds",
            "params": [1],
            "timeout_ms": 60000,
            "max_retries": 0,
            "retry_interval": 0,
            "action": {
                "template": "L1_action/control_actions.json/wait_seconds.u16.r_b_wait_done"
            },
            "judge ": {
                "type": "exists"
            },
            "on_success": [
                {
                    "type": "log",
                    "message": "wait ${param_0}s done"
                }
            ],
            "on_failure": [
                {
                    "type": "log",
                    "message": "Wait failed"
                }
            ],
            "on_timeout": [
                {
                    "type": "log",
                    "message": "Wait timeout"
                }
            ]
        }
    ]
}