{
    "type": "node_bundle",
    "description": "variable operation node collection",
    "version": "1.0.0",
    "nodes": [
        {
            "filename": "set_variable.s_s",
            "type": "node",
            "name": "Set variable",
            "description": "Set variable value",
            "params": ["position_1", "0"],
            "timeout_ms": 1000,
            "max_retries": 0,
            "retry_interval": 0,
            "action": {
                "template": "L1_action/system_actions.json/set_variable.s_s"
            },
            "judge ": {
                "type": "exists"
            },
            "on_success": [
                {
                    "type": "log",
                    "message": "Variable ${param_0} set to: ${param_1}"
                }
            ],
            "on_failure": [
                {
                    "type": "log",
                    "message": "Set variablefailed"
                }
            ],
            "on_timeout": [
                {
                    "type": "log",
                    "message": "Set variabletimeout"
                }
            ]
        }
    ]
}