{
    "type": "node_bundle",
    "description": "变量操作类执行节点集合",
    "version": "1.0.0",
    "nodes": [
        {
            "filename": "set_variable.s_s",
            "type": "node",
            "name": "设置变量",
            "description": "设置指定变量的值",
            "params": ["position_1", "0"],
            "timeout_ms": 1000,
            "max_retries": 0,
            "retry_interval": 0,
            "action": {
                "template": "L1_action/system_actions.json/set_variable.s_s"
            },
            "judge": {
                "type": "exists"
            },
            "on_success": [
                {
                    "type": "log",
                    "message": "变量${param_0}设置为：${param_1}"
                }
            ],
            "on_failure": [
                {
                    "type": "log",
                    "message": "设置变量失败"
                }
            ],
            "on_timeout": [
                {
                    "type": "log",
                    "message": "设置变量超时"
                }
            ]
        }
    ]
}