{
    "type": "group",
    "name": "step 04 in bottle rinsing",
    "mode": "sequence",
    "body": [
        {
            "type": "node",
            "template": "L2_node/all_nodes.json/update_ui.s_s",
            "params": [
                "stage",
                "04"
            ]
        },
        {
            "type": "group",
            "template": "L3_group/move_production_point.group.json",
            "params": [
                "${recipes[recipe_index].empty_entry}"
            ]
        },
        {
            "type": "group",
            "template": "L3_group/move_production_point.group.json",
            "params": [
                "${recipes[recipe_index].rinse_entry}"
            ]
        },
        {
            "type": "group",
            "template": "L3_group/move_production_point.group.json",
            "params": [
                "${recipes[recipe_index].rinse_work}"
            ]
        },
        {
            "type": "node",
            "template": "L2_node/all_nodes.json/write_050012.u16.r_b_done",
            "params": [
                65280
            ],
            "device": "RinseValve"
        },
        {
            "type": "node",
            "template": "L2_node/all_nodes.json/wait_ms.u32.r_b_done",
            "params": [
                5000
            ]
        },
        {
            "type": "node",
            "template": "L2_node/all_nodes.json/write_050012.u16.r_b_done",
            "params": [
                0
            ],
            "device": "RinseValve"
        },
        {
            "type": "node",
            "template": "L2_node/all_nodes.json/read_fc03_reg0010_le_rinse_pressure_low.r_b_check_ok",
            "params": [],
            "device": "PressureSensor"
        },
        {
            "type": "node",
            "template": "L2_node/all_nodes.json/write_050013.u16.r_b_done",
            "params": [
                65280
            ],
            "device": "CIPValve"
        },
        {
            "type": "node",
            "template": "L2_node/all_nodes.json/wait_ms.u32.r_b_done",
            "params": [
                3000
            ]
        },
        {
            "type": "node",
            "template": "L2_node/all_nodes.json/write_050013.u16.r_b_done",
            "params": [
                0
            ],
            "device": "CIPValve"
        },
        {
            "type": "node",
            "template": "L2_node/all_nodes.json/write_050014.u16.r_b_done",
            "params": [
                65280
            ],
            "device": "CIPValve"
        },
        {
            "type": "node",
            "template": "L2_node/all_nodes.json/wait_ms.u32.r_b_done",
            "params": [
                3000
            ]
        },
        {
            "type": "node",
            "template": "L2_node/all_nodes.json/write_050014.u16.r_b_done",
            "params": [
                0
            ],
            "device": "CIPValve"
        },
        {
            "type": "node",
            "template": "L2_node/all_nodes.json/update_ui.s_s",
            "params": [
                "WashState",
                "done"
            ]
        },
        {
            "type": "group",
            "template": "L3_group/move_production_point.group.json",
            "params": [
                "${recipes[recipe_index].rinse_entry}"
            ]
        }
    ]
