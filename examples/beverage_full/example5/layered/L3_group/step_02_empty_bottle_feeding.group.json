{
    "type": "group",
    "name": "step 02 empty bottle feeding",
    "mode": "sequence",
    "body": [
        {
            "type": "node",
            "template": "L2_node/all_nodes.json/update_ui.s_s",
            "params": [
                "stage",
                "02"
            ]
        },
        {
            "type": "node",
            "template": "L2_node/all_nodes.json/write_050008.u16.r_b_done",
            "params": [
                65280
            ],
            "device": "Relay"
        },
        {
            "type": "group",
            "template": "L3_group/trigger_motor.group.json",
            "params": [
                "Infeed",
                "${recipes[recipe_index].infeed_pr}"
            ]
        },
        {
            "type": "group",
            "name": "Wait for Infeed",
            "template": "L3_group/poll_sensor_until_ready.group.json",
            "params": [
                "L2_node/all_nodes.json/read_fc04_reg0000_expected.r_b_poll_ready",
                "Infeed",
                20,
                4000,
                202,
                "EMPTY_FEED_TIMEOUT",
                "empty feed timeout"
            ]
        },
        {
            "type": "group",
            "name": "Check bottle sensor and wait (5s)",
            "template": "L3_group/poll_sensor_until_ready.group.json",
            "params": [
                "L2_node/all_nodes.json/read_fc04_reg0034_expected.r_b_poll_ready",
                "BottleSensor",
                100,
                5000,
                52,
                "BOTTLE_SENSOR_TIMEOUT",
                "Bottle sensor not triggered, check feed"
            ]
        },
        {
            "type": "node",
            "template": "L2_node/all_nodes.json/write_050008.u16.r_b_done",
            "params": [
                0
            ],
            "device": "Relay"
        },
        {
            "type": "group",
            "template": "L3_group/move_production_point.group.json",
            "params": [
                "${recipes[recipe_index].empty_entry}"
            ]
        },
        {
            "type": "group",
            "template": "L3_group/move_production_point.group.json",
            "params": [
                "${recipes[recipe_index].empty_work}"
            ]
        },
        {
            "type": "node",
            "template": "L2_node/all_nodes.json/write_050000.u16.r_b_done",
            "params": [
                65280
            ],
            "device": "Gripper"
        },
        {
            "type": "group",
            "name": "Check pick sensor",
            "template": "L3_group/poll_sensor_until_ready.group.json",
            "params": [
                "L2_node/all_nodes.json/read_fc04_reg0041_expected.r_b_poll_ready",
                "BottleSensor",
                50,
                3000,
                62,
                "PICK_TIMEOUT",
                "Pick not in place"
            ]
        }
    ]
}
