{
    "type": "action_bundle",
    "description": " motorcontrol action collection",
    "version": "1.0.0",
    "actions": [
        {
            "filename": "write_pr_position.u8_i32.r_b_write_pr_result",
            "type": "modbus_write_verify",
            "description": "write PR point coordinate (32-bit)",
            "protocol": "modbus",
            "request": "06 00 20 ${pr_number} ${position_high} ${position_mid} ${position_low}",
            "response": "06 00 20 ${pr_number} ${position_high} ${position_mid} ${position_low}",
            "timeout_ms": 5000,
            "args": [
                { "index": 0, "name": "pr_number", "type": "u8", "min": 0, "max": 255 },
                { "index": 1, "name": "position", "type": "i32" }
            ]
        },
        {
            "filename": "read_pr_position.u8.r_i32_pr_position",
            "type": "modbus_read_cache",
            "description": "read PR point coordinate",
            "protocol": "modbus",
            "request": "03 00 20 ${pr_number} 00 02",
            "parse": {
                "start_byte": 2,
                "length": 4,
                "endian": "big",
                "type": "int32"
            },
            "timeout_ms": 2000,
            "args": [
                { "index": 0, "name": "pr_number", "type": "u8", "min": 0, "max": 255 }
            ]
        },
        {
            "filename": "pr_run.u8.r_b_pr_run_result",
            "type": "modbus_write_verify",
            "description": "trigger PR point run",
            "protocol": "modbus",
            "request": "06 00 02 ${pr_number} 00 01",
            "response": "06 00 02 ${pr_number} 00 01",
            "timeout_ms": 3000,
            "args": [
                { "index": 0, "name": "pr_number", "type": "u8", "min": 0, "max": 255 }
            ]
        },
        {
            "filename": "check_motion_done.r_b_motion_done",
            "type": "modbus_read_check",
            "description": "check motor motion done",
            "protocol": "modbus",
            "request": "03 00 10 00 01",
            "parse": {
                "start_byte": 2,
                "length": 2,
                "endian": "big",
                "type": "uint16"
            },
            "check": {
                "condition": "eq",
                "value": 0
            },
            "timeout_ms": 1000,
            "args": []
        },
        {
            "filename": "jog_start.u16.r_b_jog_start_result",
            "type": "modbus_write_verify",
            "description": "start forward jog",
            "protocol": "modbus",
            "request": "06 00 03 ${speed_high} ${speed_low} 06 00 04 00 01",
            "response": "06 00 03 ${speed_high} ${speed_low}",
            "timeout_ms": 3000,
            "args": [
                { "index": 0, "name": "speed", "type": "u16", "min": 1, "max": 100, "default": 10 }
            ]
        },
        {
            "filename": "jog_stop.r_b_jog_stop_result",
            "type": "modbus_write_verify",
            "description": "stop jog",
            "protocol": "modbus",
            "request": "06 00 04 00 00",
            "response": "06 00 04 00 00",
            "timeout_ms": 3000,
            "args": []
        },
        {
            "filename": "read_sensor.u8.r_u16_sensor_value",
            "type": "modbus_read_cache",
            "description": "read photoelectric switchstatus",
            "protocol": "modbus",
            "request": "03 ${register} 00 01",
            "parse": {
                "start_byte": 2,
                "length": 2,
                "endian": "big",
                "type": "uint16"
            },
            "timeout_ms": 1000,
            "args": [
                { "index": 0, "name": "register", "type": "u8", "min": 0, "max": 255 }
            ]
        },
        {
            "filename": "read_current_position.r_i32_current_position",
            "type": "modbus_read_cache",
            "description": "read current absolute position (32-bit)",
            "protocol": "modbus",
            "request": "03 00 10 00 02",
            "parse": {
                "start_byte": 2,
                "length": 4,
                "endian": "big",
                "type": "int32"
            },
            "timeout_ms": 2000,
            "args": []
        }
    ]
}