{
    "type": "action_bundle",
    "description": "systemcontrol action collection",
    "version": "1.0.0",
    "actions": [
        {
            "filename": "log.s",
            "type": "log",
            "description": "write log",
            "args": [
                { "index": 0, "name": "message", "type": "s" }
            ]
        },
        {
            "filename": "popup.s_s",
            "type": "popup",
            "description": "show popup prompt",
            "args": [
                { "index": 0, "name": "message", "type": "s" },
                { "index": 1, "name": "level", "type": "s", "enum": ["info", "warning", "error", "success"], "default": "info" }
            ]
        },
        {
            "filename": "set_variable.s_s",
            "type": "set",
            "description": "Set variable value",
            "args": [
                { "index": 0, "name": "key", "type": "s" },
                { "index": 1, "name": "value", "type": "s" }
            ]
        }
    ]
}