{
    "type": "action_bundle",
    "description": "Modbus communicationaction collection",
    "version": "1.0.0",
    "actions": [
        {
            "filename": "read_pressure.u8_u16.r_u16_pressure",
            "type": "modbus_read_cache",
            "description": "Read Pressure sensor value",
            "protocol": "modbus",
            "request": "03 ${slave_id} ${register} 00 01",
            "parse": {
                "start_byte": 2,
                "length": 2,
                "endian": "big",
                "type": "uint16"
            },
            "timeout_ms": 2000,
            "args": [
                { "index": 0, "name": "slave_id", "type": "u8", "min": 0, "max": 255 },
                { "index": 1, "name": "register", "type": "u16", "min": 0, "max": 65535 }
            ]
        },
        {
            "filename": "write_coil_on.r_b_coil_on_result",
            "type": "modbus_write_verify",
            "description": "write coil on",
            "protocol": "modbus",
            "request": "05 ${coil} FF 00",
            "response": "05 ${coil} FF 00",
            "timeout_ms": 3000,
            "args": [
                { "index": 0, "name": "coil", "type": "u16", "min": 0, "max": 65535 }
            ]
        },
        {
            "filename": "write_coil_off.r_b_coil_off_result",
            "type": "modbus_write_verify",
            "description": "write coil off",
            "protocol": "modbus",
            "request": "05 ${coil} 00 00",
            "response": "05 ${coil} 00 00",
            "timeout_ms": 3000,
            "args": [
                { "index": 0, "name": "coil", "type": "u16", "min": 0, "max": 65535 }
            ]
        },
        {
            "filename": "write_register.u16_u16.r_b_write_register_result",
            "type": "modbus_write_verify",
            "description": "write register",
            "protocol": "modbus",
            "request": "06 ${register} ${value_high} ${value_low}",
            "response": "06 ${register} ${value_high} ${value_low}",
            "timeout_ms": 3000,
            "args": [
                { "index": 0, "name": "register", "type": "u16", "min": 0, "max": 65535 },
                { "index": 1, "name": "value", "type": "u16", "min": 0, "max": 65535 }
            ]
        }
    ]
}