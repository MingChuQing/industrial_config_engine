{
    "type": "action_bundle",
    "description": "Leak testing system L1 atomic action collection",
    "version": "1.0.0",
    "actions": [
        {
            "filename": "digital_read.u8.r_b_digital_state",
            "type": "modbus_read_cache",
            "description": "read digital input status",
            "protocol": "modbus",
            "request": "02 ${register} 00 01",
            "parse": {
                "start_byte": 2,
                "length": 1,
                "endian": "big",
                "type": "uint8"
            },
            "timeout_ms": 1000,
            "args": [
                { "index": 0, "name": "register", "type": "u8", "min": 0, "max": 255, "desc": "register address" }
            ]
        },
        {
            "filename": "digital_write.u8_b.r_b_write_result",
            "type": "modbus_write_verify",
            "description": "write digital output",
            "protocol": "modbus",
            "request": "05 ${register} ${value}",
            "response": "05 ${register} ${value}",
            "timeout_ms": 1000,
            "args": [
                { "index": 0, "name": "register", "type": "u8", "min": 0, "max": 255, "desc": "register address" },
                { "index": 1, "name": "value", "type": "b", "desc": "true=ON(FF00), false=OFF(0000)" }
            ]
        },
        {
            "filename": "digital_write_on.u8.r_b_write_result",
            "type": "modbus_write_verify",
            "description": "digital output set ON",
            "protocol": "modbus",
            "request": "05 ${register} FF 00",
            "response": "05 ${register} FF 00",
            "timeout_ms": 1000,
            "args": [
                { "index": 0, "name": "register", "type": "u8", "min": 0, "max": 255, "desc": "register address" }
            ]
        },
        {
            "filename": "digital_write_off.u8.r_b_write_result",
            "type": "modbus_write_verify",
            "description": "digital output set OFF",
            "protocol": "modbus",
            "request": "05 ${register} 00 00",
            "response": "05 ${register} 00 00",
            "timeout_ms": 1000,
            "args": [
                { "index": 0, "name": "register", "type": "u8", "min": 0, "max": 255, "desc": "register address" }
            ]
        },
        {
            "filename": "read_analog.u8.r_f_analog_value",
            "type": "modbus_read_cache",
            "description": "read analog channel value (0-10V/4-20mA)",
            "protocol": "modbus",
            "request": "03 ${channel} 00 01",
            "parse": {
                "start_byte": 2,
                "length": 2,
                "endian": "big",
                "type": "uint16"
            },
            "timeout_ms": 1000,
            "args": [
                { "index": 0, "name": "channel", "type": "u8", "min": 0, "max": 255, "desc": "analog channel" }
            ]
        },
        {
            "filename": "read_pressure.u8.r_f_pressure",
            "type": "modbus_read_cache",
            "description": "Read Pressure sensor value (kPa)",
            "protocol": "modbus",
            "request": "03 ${channel} 00 01",
            "parse": {
                "start_byte": 2,
                "length": 2,
                "endian": "big",
                "type": "uint16"
            },
            "timeout_ms": 1000,
            "args": [
                { "index": 0, "name": "channel", "type": "u8", "min": 0, "max": 255, "desc": "pressure sensor channel" }
            ]
        },
        {
            "filename": "read_temperature.u8.r_f_temperature",
            "type": "modbus_read_cache",
            "description": "read temperature sensor value (degC)",
            "protocol": "modbus",
            "request": "03 ${channel} 00 01",
            "parse": {
                "start_byte": 2,
                "length": 2,
                "endian": "big",
                "type": "uint16"
            },
            "timeout_ms": 1000,
            "args": [
                { "index": 0, "name": "channel", "type": "u8", "min": 0, "max": 255, "desc": "temperature sensor channel" }
            ]
        },
        {
            "filename": "read_modbus_register.u8_u16.r_u16_register_value",
            "type": "modbus_read_cache",
            "description": "read Modbusregister",
            "protocol": "modbus",
            "request": "03 ${addr} ${reg} 00 01",
            "parse": {
                "start_byte": 2,
                "length": 2,
                "endian": "big",
                "type": "uint16"
            },
            "timeout_ms": 1000,
            "args": [
                { "index": 0, "name": "addr", "type": "u8", "min": 0, "max": 255, "desc": "slave address" },
                { "index": 1, "name": "reg", "type": "u16", "min": 0, "max": 65535, "desc": "register address" }
            ]
        },
        {
            "filename": "write_modbus_register.u8_u16_u16.r_b_write_result",
            "type": "modbus_write_verify",
            "description": "write Modbusregister",
            "protocol": "modbus",
            "request": "06 ${addr} ${reg} ${val_high} ${val_low}",
            "response": "06 ${addr} ${reg} ${val_high} ${val_low}",
            "timeout_ms": 1000,
            "args": [
                { "index": 0, "name": "addr", "type": "u8", "min": 0, "max": 255, "desc": "slave address" },
                { "index": 1, "name": "reg", "type": "u16", "min": 0, "max": 65535, "desc": "register address" },
                { "index": 2, "name": "val", "type": "u16", "min": 0, "max": 65535, "desc": "write value" }
            ]
        },
        {
            "filename": "open_fill_valve.r_b_valve_result",
            "type": "modbus_write_verify",
            "description": "open fill valve",
            "protocol": "modbus",
            "request": "05 00 01 FF 00",
            "response": "05 00 01 FF 00",
            "timeout_ms": 1000
        },
        {
            "filename": "close_fill_valve.r_b_valve_result",
            "type": "modbus_write_verify",
            "description": "close fill valve",
            "protocol": "modbus",
            "request": "05 00 01 00 00",
            "response": "05 00 01 00 00",
            "timeout_ms": 1000
        },
        {
            "filename": "open_exhaust_valve.r_b_valve_result",
            "type": "modbus_write_verify",
            "description": "open exhaust valve",
            "protocol": "modbus",
            "request": "05 00 02 FF 00",
            "response": "05 00 02 FF 00",
            "timeout_ms": 1000
        },
        {
            "filename": "close_exhaust_valve.r_b_valve_result",
            "type": "modbus_write_verify",
            "description": "close exhaust valve",
            "protocol": "modbus",
            "request": "05 00 02 00 00",
            "response": "05 00 02 00 00",
            "timeout_ms": 1000
        },
        {
            "filename": "clamp_close.r_b_clamp_result",
            "type": "modbus_write_verify",
            "description": "fixture close",
            "protocol": "modbus",
            "request": "05 00 03 FF 00",
            "response": "05 00 03 FF 00",
            "timeout_ms": 2000
        },
        {
            "filename": "clamp_open.r_b_clamp_result",
            "type": "modbus_write_verify",
            "description": "fixture open",
            "protocol": "modbus",
            "request": "05 00 03 00 00",
            "response": "05 00 03 00 00",
            "timeout_ms": 2000
        },
        {
            "filename": "check_clamp_closed.r_b_clamp_closed",
            "type": "modbus_read_cache",
            "description": "check fixture fully closed",
            "protocol": "modbus",
            "request": "02 00 04 00 01",
            "parse": {
                "start_byte": 2,
                "length": 1,
                "endian": "big",
                "type": "uint8"
            },
            "timeout_ms": 1000
        },
        {
            "filename": "calculate.f_f.r_f_calc_result",
            "type": "calculate",
            "description": "float arithmetic",
            "expression": "${expression}",
            "args": [
                { "index": 0, "name": "expression", "type": "s", "desc": "arithmetic expression" }
            ]
        },
        {
            "filename": "calculate_pressure_drop.f_f.r_f_pressure_drop",
            "type": "calculate",
            "description": "calculate pressure drop dP = P_start - P_end",
            "expression": "${p_start} - ${p_end}",
            "args": [
                { "index": 0, "name": "p_start", "type": "f", "desc": "initial pressure (kPa)" },
                { "index": 1, "name": "p_end", "type": "f", "desc": "final pressure (kPa)" }
            ]
        },
        {
            "filename": "calculate_leak_rate.f_f.r_f_leak_rate",
            "type": "calculate",
            "description": "calculate leak rate = dP / time (kPa/min)",
            "expression": "${delta_p} / (${duration} / 60.0)",
            "args": [
                { "index": 0, "name": "delta_p", "type": "f", "desc": "pressure drop (kPa)" },
                { "index": 1, "name": "duration", "type": "f", "desc": "test duration (s)" }
            ]
        },
        {
            "filename": "save_test_data.s_f_f_s_s.r_b_save_result",
            "type": "script_exec",
            "description": "save test data to database/file",
            "script_type": "python",
            "script_file": "save_test_data.py",
            "args": [
                { "index": 0, "name": "product_id", "type": "s", "desc": "product ID" },
                { "index": 1, "name": "leak_rate", "type": "f", "desc": "leak rate" },
                { "index": 2, "name": "result", "type": "s", "desc": "PASS/FAIL" },
                { "index": 3, "name": "timestamp", "type": "s", "desc": "timestamp" }
            ]
        },
        {
            "filename": "log.s",
            "type": "log",
            "description": "write log",
            "message": "${message}",
            "args": [
                { "index": 0, "name": "message", "type": "s", "desc": "Log content" }
            ]
        },
        {
            "filename": "popup.s_s",
            "type": "popup",
            "description": "popup prompt",
            "message": "${message}",
            "level": "${level}",
            "args": [
                { "index": 0, "name": "message", "type": "s", "desc": "prompt content" },
                { "index": 1, "name": "level", "type": "s", "enum": ["info","warning","error","success"], "desc": "prompt level" }
            ]
        },
        {
            "filename": "beep.u8.r_b_beep_result",
            "type": "script_exec",
            "description": "buzzeralarm",
            "script_type": "python",
            "script_file": "beep.py",
            "args": [
                { "index": 0, "name": "duration", "type": "u8", "min": 1, "max": 10, "desc": "buzzer duration(s)" }
            ]
        },
        {
            "filename": "led_set.s.r_b_led_result",
            "type": "modbus_write_verify",
            "description": "set indicator light color",
            "protocol": "modbus",
            "request": "06 00 05 ${color} 00",
            "response": "06 00 05 ${color} 00",
            "timeout_ms": 500,
            "args": [
                { "index": 0, "name": "color", "type": "s", "enum": ["green", "yellow", "red"], "desc": "color" }
            ]
        }
    ]
}