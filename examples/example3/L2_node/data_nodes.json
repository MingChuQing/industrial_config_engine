{
    "type": "node_bundle",
    "description": "数据计算类执行节点集合",
    "version": "1.0.0",
    "nodes": [
        {
            "filename": "calculate.s.r_f_calc_result",
            "type": "node",
            "name": "计算表达式",
            "description": "计算数学表达式并返回浮点结果",
            "params": ["0"],
            "timeout_ms": 5000,
            "max_retries": 0,
            "retry_interval": 0,
            "action": {
                "template": "L1_action/data_actions.json/calculate.s.r_f_calc_result"
            },
            "judge": {
                "type": "exists"
            },
            "on_success": [
                {
                    "type": "log",
                    "message": "计算结果：${calc_result}"
                }
            ],
            "on_failure": [
                {
                    "type": "log",
                    "message": "计算失败"
                }
            ],
            "on_timeout": [
                {
                    "type": "log",
                    "message": "计算超时"
                }
            ]
        }
    ]
}