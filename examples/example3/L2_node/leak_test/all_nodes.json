{
    "type": "node_bundle",
    "description": "Leak test L2 node bundle",
    "version": "1.0.0",
    "nodes": [
        {
            "filename": "check_air_pressure.u8.r_b_air_ok",
            "name": "Check air pressure",
            "description": "Check air pressureif >= 0.4MPa",
            "params": ["${pressure_channel}"],
            "timeout_ms": 2000,
            "max_retries": 3,
            "retry_interval": 500,
            "action": {
                "template": "L1_action/leak_test/all_actions.json/read_pressure.u8.r_f_pressure"
            },
            "judge ": {
                "type": "compare",
                "condition": "ge",
                "value": 0.4
            },
            "on_success": [
                { "type": "log", "message": "Air pressure OK: ${pressure} MPa" }
            ],
            "on_failure": [
                { "type": "log", "message": "Air pressure abnormal: ${pressure} MPa" },
                { "type": "popup", "message": "Air pressure low, check air supply", "level": "error" }
            ],
            "on_timeout": [
                { "type": "log", "message": "Air pressure read timeout" },
                { "type": "popup", "message": "Air pressure read timeout, , check sensor", "level": "error" }
            ]
        },
        {
            "filename": "check_clamp_open.r_b_clamp_open_ok",
            "name": "check fixture open",
            "description": "check if fixture is open",
            "params": [],
            "timeout_ms": 1000,
            "max_retries": 3,
            "retry_interval": 500,
            "action": {
                "template": "L1_action/leak_test/all_actions.json/check_clamp_closed.r_b_clamp_closed"
            },
            "judge ": {
                "type": "compare",
                "condition": "eq",
                "value": false
            },
            "on_success": [
                { "type": "log", "message": "fixture opened" }
            ],
            "on_failure": [
                { "type": "log", "message": "fixture not open" },
                { "type": "popup", "message": "fixture not open, check ", "level": "warning" }
            ],
            "on_timeout": [
                { "type": "log", "message": "check fixture status timeout" }
            ]
        },
        {
            "filename": "check_seal_ring.u8.r_b_seal_ok",
            "name": "check seal ring in place",
            "description": "check seal ring installed",
            "params": ["${seal_sensor_register}"],
            "timeout_ms": 1000,
            "max_retries": 3,
            "retry_interval": 500,
            "action": {
                "template": "L1_action/leak_test/all_actions.json/digital_read.u8.r_b_digital_state"
            },
            "judge ": {
                "type": "compare",
                "condition": "eq",
                "value": true
            },
            "on_success": [
                { "type": "log", "message": "seal ring in place" }
            ],
            "on_failure": [
                { "type": "log", "message": "seal ring not in place" },
                { "type": "popup", "message": "seal ring not installed, check ", "level": "error" }
            ],
            "on_timeout": [
                { "type": "log", "message": "check seal ring timeout" }
            ]
        },
        {
            "filename": "start_air_pump.r_b_pump_start_result",
            "name": "start pump",
            "description": "start pump to build air supply",
            "params": ["${pump_output_register}"],
            "timeout_ms": 3000,
            "max_retries": 3,
            "retry_interval": 500,
            "action": {
                "template": "L1_action/leak_test/all_actions.json/digital_write_on.u8.r_b_write_result"
            },
            "judge ": {
                "type": "compare",
                "condition": "eq",
                "value": true
            },
            "on_success": [
                { "type": "log", "message": "pump started" }
            ],
            "on_failure": [
                { "type": "log", "message": "pump start failed" },
                { "type": "popup", "message": "pump start failed, check ", "level": "error" }
            ],
            "on_timeout": [
                { "type": "log", "message": "pump start timeout" }
            ]
        },
        {
            "filename": "clamp_workpiece.r_b_clamp_result",
            "name": "close fixture",
            "description": "close fixture to seal product",
            "params": [],
            "timeout_ms": 2000,
            "max_retries": 3,
            "retry_interval": 500,
            "action": {
                "template": "L1_action/leak_test/all_actions.json/clamp_close.r_b_clamp_result"
            },
            "judge ": {
                "type": "compare",
                "condition": "eq",
                "value": true
            },
            "on_success": [
                { "type": "log", "message": "fixture closed" }
            ],
            "on_failure": [
                { "type": "log", "message": "fixture close failed" },
                { "type": "popup", "message": "fixture close failed, check ", "level": "error" }
            ],
            "on_timeout": [
                { "type": "log", "message": "fixture close timeout" }
            ]
        },
        {
            "filename": "check_clamp_closed.r_b_clamp_closed",
            "name": "confirm fixture fully closed",
            "description": "confirm fixture fully closed",
            "params": [],
            "timeout_ms": 1000,
            "max_retries": 3,
            "retry_interval": 500,
            "action": {
                "template": "L1_action/leak_test/all_actions.json/check_clamp_closed.r_b_clamp_closed"
            },
            "judge ": {
                "type": "compare",
                "condition": "eq",
                "value": true
            },
            "on_success": [
                { "type": "log", "message": "fixture fully closed" }
            ],
            "on_failure": [
                { "type": "log", "message": "fixture not fully closed" },
                { "type": "popup", "message": "fixture not fully closed, check ", "level": "error" }
            ],
            "on_timeout": [
                { "type": "log", "message": "check fixture position timeout" }
            ]
        },
        {
            "filename": "open_fill_valve.r_b_valve_result",
            "name": "open fill valve",
            "description": "open fill solenoid valve",
            "params": [],
            "timeout_ms": 1000,
            "max_retries": 3,
            "retry_interval": 500,
            "action": {
                "template": "L1_action/leak_test/all_actions.json/open_fill_valve.r_b_valve_result"
            },
            "judge ": {
                "type": "compare",
                "condition": "eq",
                "value": true
            },
            "on_success": [
                { "type": "log", "message": "fill valve opened" }
            ],
            "on_failure": [
                { "type": "log", "message": "open fill valve failed" },
                { "type": "popup", "message": "open fill valve failed, check ", "level": "error" }
            ],
            "on_timeout": [
                { "type": "log", "message": "open fill valve timeout" }
            ]
        },
        {
            "filename": "monitor_pressure_rising.u8_f_u16.r_b_pressure_rising",
            "name": "monitor pressure rise",
            "description": "monitor if pressure rises to target",
            "params": ["${pressure_channel}", "${target_pressure}", "${fill_timeout}"],
            "timeout_ms": "${fill_timeout}",
            "max_retries": 0,
            "retry_interval": 0,
            "action": {
                "template": "L1_action/leak_test/all_actions.json/read_pressure.u8.r_f_pressure"
            },
            "judge ": {
                "type": "compare",
                "condition": "ge",
                "value": "${target_pressure}"
            },
            "on_success": [
                { "type": "log", "message": "pressure reached target: ${pressure} kPa" }
            ],
            "on_failure": [
                { "type": "log", "message": "pressure below target: ${pressure} kPa" }
            ],
            "on_timeout": [
                { "type": "log", "message": "fill timeout" }
            ]
        },
        {
            "filename": "check_large_leak.u8_f_f.r_b_large_leak",
            "name": "check large leak",
            "description": "detect Filling stage pressurerise ratejudge  large leak",
            "params": ["${pressure_channel}", "${large_leak_threshold}", "${fill_timeout}"],
            "timeout_ms": 1000,
            "max_retries": 3,
            "retry_interval": 500,
            "action": {
                "template": "L1_action/leak_test/all_actions.json/read_pressure.u8.r_f_pressure"
            },
            "judge ": {
                "type": "expression",
                "expression": "${pressure} / (${fill_timeout} / 1000) < ${large_leak_threshold}"
            },
            "on_success": [
                { "type": "log", "message": "large leak detected: pressure rises slowly" },
                { "type": "popup", "message": "large leak detected, , check seal", "level": "error" }
            ],
            "on_failure": [
                { "type": "log", "message": "no large leak detected, continue fill" }
            ],
            "on_timeout": [
                { "type": "log", "message": "large-leak detection timeout" }
            ]
        },
        {
            "filename": "close_fill_valve.r_b_valve_result",
            "name": "close fill valve",
            "description": "close fill solenoid valve",
            "params": [],
            "timeout_ms": 1000,
            "max_retries": 3,
            "retry_interval": 500,
            "action": {
                "template": "L1_action/leak_test/all_actions.json/close_fill_valve.r_b_valve_result"
            },
            "judge ": {
                "type": "compare",
                "condition": "eq",
                "value": true
            },
            "on_success": [
                { "type": "log", "message": "fill valve closed" }
            ],
            "on_failure": [
                { "type": "log", "message": "close fill valve failed" },
                { "type": "popup", "message": "close fill valve failed, check ", "level": "error" }
            ],
            "on_timeout": [
                { "type": "log", "message": "close fill valve timeout" }
            ]
        },
        {
            "filename": "wait.u16.r_b_wait_done",
            "name": "wait ",
            "description": "wait specified duration",
            "params": ["${duration}"],
            "timeout_ms": "${duration} + 1000",
            "max_retries": 0,
            "retry_interval": 0,
            "action": {
                "template": "L1_action/control/wait.u16_s.r_b_wait_done"
            },
            "judge ": {
                "type": "compare",
                "condition": "eq",
                "value": true
            },
            "on_success": [
                { "type": "log", "message": "wait  ${duration} ms done" }
            ],
            "on_failure": [],
            "on_timeout": []
        },
        {
            "filename": "read_stable_pressure.u8.r_f_stable_pressure",
            "name": "read stable pressure",
            "description": "read stable pressure value P_start",
            "params": ["${pressure_channel}"],
            "timeout_ms": 1000,
            "max_retries": 3,
            "retry_interval": 500,
            "action": {
                "template": "L1_action/leak_test/all_actions.json/read_pressure.u8.r_f_pressure"
            },
            "judge ": {
                "type": "exists"
            },
            "on_success": [
                { "type": "log", "message": "P_start = ${stable_pressure} kPa" }
            ],
            "on_failure": [
                { "type": "log", "message": "read stable pressurefailed" },
                { "type": "popup", "message": "read stable pressurefailed", "level": "error" }
            ],
            "on_timeout": [
                { "type": "log", "message": "read stable pressuretimeout" }
            ]
        },
        {
            "filename": "check_pressure_stable.u8_f_u16.r_b_stable",
            "name": "check pressure stability",
            "description": "check if pressure fluctuation stable",
            "params": ["${pressure_channel}", "${stable_threshold}", "${dwell_time}"],
            "timeout_ms": "${dwell_time}",
            "max_retries": 3,
            "retry_interval": 500,
            "action": {
                "template": "L1_action/leak_test/all_actions.json/read_pressure.u8.r_f_pressure"
            },
            "judge ": {
                "type": "compare",
                "condition": "le",
                "value": "${stable_threshold}"
            },
            "on_success": [
                { "type": "log", "message": "pressure stable" }
            ],
            "on_failure": [
                { "type": "log", "message": "pressure unstable" },
                { "type": "popup", "message": "pressure unstable, , check seal", "level": "warning" }
            ],
            "on_timeout": [
                { "type": "log", "message": "pressure stabilize wait timeout" }
            ]
        },
        {
            "filename": "read_pressure_value.u8.r_f_pressure_value",
            "name": "Read Pressure value",
            "description": "read current pressure value",
            "params": ["${pressure_channel}"],
            "timeout_ms": 1000,
            "max_retries": 3,
            "retry_interval": 500,
            "action": {
                "template": "L1_action/leak_test/all_actions.json/read_pressure.u8.r_f_pressure"
            },
            "judge ": {
                "type": "exists"
            },
            "on_success": [
                { "type": "log", "message": "current pressure: ${pressure_value} kPa" }
            ],
            "on_failure": [
                { "type": "log", "message": "Read Pressurefailed" }
            ],
            "on_timeout": [
                { "type": "log", "message": "Read Pressuretimeout" }
            ]
        },
        {
            "filename": "wait_test_duration.u16.r_b_wait_done",
            "name": "test timer wait",
            "description": "Test stage timer",
            "params": ["${test_duration}"],
            "timeout_ms": "${test_duration} + 2000",
            "max_retries": 0,
            "retry_interval": 0,
            "action": {
                "template": "L1_action/control/wait.u16_s.r_b_wait_done"
            },
            "judge ": {
                "type": "compare",
                "condition": "eq",
                "value": true
            },
            "on_success": [
                { "type": "log", "message": "test timer done" }
            ],
            "on_failure": [],
            "on_timeout": []
        },
        {
            "filename": "read_final_pressure.u8.r_f_final_pressure",
            "name": "read final pressure",
            "description": "read pressure at end of test P_end",
            "params": ["${pressure_channel}"],
            "timeout_ms": 1000,
            "max_retries": 3,
            "retry_interval": 500,
            "action": {
                "template": "L1_action/leak_test/all_actions.json/read_pressure.u8.r_f_pressure"
            },
            "judge ": {
                "type": "exists"
            },
            "on_success": [
                { "type": "log", "message": "P_end = ${final_pressure} kPa" }
            ],
            "on_failure": [
                { "type": "log", "message": "read final pressurefailed" }
            ],
            "on_timeout": [
                { "type": "log", "message": "read final pressuretimeout" }
            ]
        },
        {
            "filename": "calculate_delta_p.f_f.r_f_delta_p",
            "name": "calculate pressure drop",
            "description": "calculate  dP = P_start - P_end",
            "params": ["${p_start}", "${p_end}"],
            "timeout_ms": 1000,
            "max_retries": 0,
            "retry_interval": 0,
            "action": {
                "template": "L1_action/leak_test/all_actions.json/calculate_pressure_drop.f_f.r_f_pressure_drop"
            },
            "judge ": {
                "type": "exists"
            },
            "on_success": [
                { "type": "log", "message": "dP = ${delta_p} kPa" }
            ],
            "on_failure": [
                { "type": "log", "message": "calculate pressure dropfailed" }
            ],
            "on_timeout": []
        },
        {
            "filename": "calculate_leak_rate.f_f.r_f_leak_rate",
            "name": "calculate leak rate",
            "description": "calculate leak rate = dP / time (kPa/min)",
            "params": ["${delta_p}", "${test_duration}"],
            "timeout_ms": 1000,
            "max_retries": 0,
            "retry_interval": 0,
            "action": {
                "template": "L1_action/leak_test/all_actions.json/calculate_leak_rate.f_f.r_f_leak_rate"
            },
            "judge ": {
                "type": "exists"
            },
            "on_success": [
                { "type": "log", "message": "leak rate = ${leak_rate} kPa/min" }
            ],
            "on_failure": [
                { "type": "log", "message": "calculate leak ratefailed" }
            ],
            "on_timeout": []
        },
        {
            "filename": "check_leak_rate.f_f.r_b_leak_ok",
            "name": "Judge if leak rate is qualified",
            "description": "judge  if leak rate <= standard",
            "params": ["${leak_rate}", "${leak_rate_standard}"],
            "timeout_ms": 1000,
            "max_retries": 0,
            "retry_interval": 0,
            "action": {
                "template": "L1_action/leak_test/all_actions.json/calculate.f_f.r_f_calc_result"
            },
            "judge ": {
                "type": "compare",
                "condition": "le",
                "value": "${leak_rate_standard}"
            },
            "on_success": [
                { "type": "log", "message": "leak rate qualified: ${leak_rate} <= ${leak_rate_standard}" }
            ],
            "on_failure": [
                { "type": "log", "message": "leak rate unqualified: ${leak_rate} > ${leak_rate_standard}" }
            ],
            "on_timeout": []
        },
        {
            "filename": "set_test_result.s.r_b_set_result",
            "name": "Set test result",
            "description": "Set test result (PASS/FAIL)",
            "params": ["${result}"],
            "timeout_ms": 1000,
            "max_retries": 0,
            "retry_interval": 0,
            "action": {
                "template": "L1_action/variable/set.s_s"
            },
            "judge ": {
                "type": "exists"
            },
            "on_success": [
                { "type": "log", "message": "Test result set to ${result}" }
            ],
            "on_failure": [
                { "type": "log", "message": "Set test resultfailed" }
            ],
            "on_timeout": []
        },
        {
            "filename": "open_exhaust_valve.r_b_valve_result",
            "name": "open exhaust valve",
            "description": "open exhaust valverelease pressure",
            "params": [],
            "timeout_ms": 1000,
            "max_retries": 3,
            "retry_interval": 500,
            "action": {
                "template": "L1_action/leak_test/all_actions.json/open_exhaust_valve.r_b_valve_result"
            },
            "judge ": {
                "type": "compare",
                "condition": "eq",
                "value": true
            },
            "on_success": [
                { "type": "log", "message": "exhaust valve opened" }
            ],
            "on_failure": [
                { "type": "log", "message": "open exhaust valve failed" },
                { "type": "popup", "message": "open exhaust valve failed", "level": "error" }
            ],
            "on_timeout": [
                { "type": "log", "message": "open exhaust valve timeout" }
            ]
        },
        {
            "filename": "wait_pressure_zero.u8_f_u16.r_b_pressure_zero",
            "name": "wait pressure zero",
            "description": "wait pressure drop below zero",
            "params": ["${pressure_channel}", "${zero_threshold}", "${max_wait}"],
            "timeout_ms": "${max_wait}",
            "max_retries": 0,
            "retry_interval": 0,
            "action": {
                "template": "L1_action/leak_test/all_actions.json/read_pressure.u8.r_f_pressure"
            },
            "judge ": {
                "type": "compare",
                "condition": "le",
                "value": "${zero_threshold}"
            },
            "on_success": [
                { "type": "log", "message": "pressure zeroed: ${pressure} kPa" }
            ],
            "on_failure": [
                { "type": "log", "message": "pressure not zeroed: ${pressure} kPa" },
                { "type": "popup", "message": "pressure not zeroed, , check exhaust", "level": "warning" }
            ],
            "on_timeout": [
                { "type": "log", "message": "wait pressure zero timeout" }
            ]
        },
        {
            "filename": "close_exhaust_valve.r_b_valve_result",
            "name": "close exhaust valve",
            "description": "close exhaust valve",
            "params": [],
            "timeout_ms": 1000,
            "max_retries": 3,
            "retry_interval": 500,
            "action": {
                "template": "L1_action/leak_test/all_actions.json/close_exhaust_valve.r_b_valve_result"
            },
            "judge ": {
                "type": "compare",
                "condition": "eq",
                "value": true
            },
            "on_success": [
                { "type": "log", "message": "exhaust valve closed" }
            ],
            "on_failure": [
                { "type": "log", "message": "close exhaust valve failed" }
            ],
            "on_timeout": [
                { "type": "log", "message": "close exhaust valve timeout" }
            ]
        },
        {
            "filename": "clamp_open_workpiece.r_b_clamp_result",
            "name": "open fixture",
            "description": "open fixture to release product",
            "params": [],
            "timeout_ms": 2000,
            "max_retries": 3,
            "retry_interval": 500,
            "action": {
                "template": "L1_action/leak_test/all_actions.json/clamp_open.r_b_clamp_result"
            },
            "judge ": {
                "type": "compare",
                "condition": "eq",
                "value": true
            },
            "on_success": [
                { "type": "log", "message": "fixture opened" }
            ],
            "on_failure": [
                { "type": "log", "message": "open fixture failed" },
                { "type": "popup", "message": "open fixturefailed, check manually", "level": "error" }
            ],
            "on_timeout": [
                { "type": "log", "message": "open fixture timeout" }
            ]
        },
        {
            "filename": "stop_air_pump.r_b_pump_stop_result",
            "name": "stop pump",
            "description": "stop pump",
            "params": ["${pump_output_register}"],
            "timeout_ms": 1000,
            "max_retries": 3,
            "retry_interval": 500,
            "action": {
                "template": "L1_action/leak_test/all_actions.json/digital_write_off.u8.r_b_write_result"
            },
            "judge ": {
                "type": "compare",
                "condition": "eq",
                "value": true
            },
            "on_success": [
                { "type": "log", "message": "pump stopped" }
            ],
            "on_failure": [
                { "type": "log", "message": "pump stop failed" }
            ],
            "on_timeout": [
                { "type": "log", "message": "pump stop timeout" }
            ]
        },
        {
            "filename": "save_test_record.s_f_f_s_s.r_b_save_result",
            "name": "save test record",
            "description": "save test data to database",
            "params": ["${product_id}", "${leak_rate}", "${result}", "${timestamp}"],
            "timeout_ms": 3000,
            "max_retries": 3,
            "retry_interval": 1000,
            "action": {
                "template": "L1_action/leak_test/all_actions.json/save_test_data.s_f_f_s_s.r_b_save_result"
            },
            "judge ": {
                "type": "compare",
                "condition": "eq",
                "value": true
            },
            "on_success": [
                { "type": "log", "message": "test record saved" }
            ],
            "on_failure": [
                { "type": "log", "message": "save test record failed" },
                { "type": "popup", "message": "save test recordfailed, check storage", "level": "warning" }
            ],
            "on_timeout": [
                { "type": "log", "message": "save test record timeout" }
            ]
        },
        {
            "filename": "show_result_popup.s_s",
            "name": "show result popup",
            "description": "show test result popup",
            "params": ["${message}", "${level}"],
            "timeout_ms": 5000,
            "max_retries": 0,
            "retry_interval": 0,
            "action": {
                "template": "L1_action/leak_test/all_actions.json/popup.s_s"
            },
            "judge ": {
                "type": "compare",
                "condition": "eq",
                "value": true
            },
            "on_success": [],
            "on_failure": [],
            "on_timeout": []
        },
        {
            "filename": "set_result_led.s.r_b_led_result",
            "name": "set result indicator light",
            "description": "set indicator light color",
            "params": ["${color}"],
            "timeout_ms": 1000,
            "max_retries": 3,
            "retry_interval": 500,
            "action": {
                "template": "L1_action/leak_test/all_actions.json/led_set.s.r_b_led_result"
