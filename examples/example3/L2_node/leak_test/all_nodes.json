{
    "type": "node_bundle",
    "description": "气密性检测系统 L2 执行节点集合",
    "version": "1.0.0",
    "nodes": [
        {
            "filename": "check_air_pressure.u8.r_b_air_ok",
            "name": "检查气源压力",
            "description": "检查气源压力是否 ≥ 0.4MPa",
            "params": ["${pressure_channel}"],
            "timeout_ms": 2000,
            "max_retries": 3,
            "retry_interval": 500,
            "action": {
                "template": "L1_action/leak_test/all_actions.json/read_pressure.u8.r_f_pressure"
            },
            "judge": {
                "type": "compare",
                "condition": "ge",
                "value": 0.4
            },
            "on_success": [
                { "type": "log", "message": "气源压力正常: ${pressure} MPa" }
            ],
            "on_failure": [
                { "type": "log", "message": "气源压力异常: ${pressure} MPa" },
                { "type": "popup", "message": "气源压力不足，请检查气源", "level": "error" }
            ],
            "on_timeout": [
                { "type": "log", "message": "读取气源压力超时" },
                { "type": "popup", "message": "读取气源压力超时，请检查传感器", "level": "error" }
            ]
        },
        {
            "filename": "check_clamp_open.r_b_clamp_open_ok",
            "name": "检查夹具是否打开",
            "description": "检查夹具是否在打开状态",
            "params": [],
            "timeout_ms": 1000,
            "max_retries": 3,
            "retry_interval": 500,
            "action": {
                "template": "L1_action/leak_test/all_actions.json/check_clamp_closed.r_b_clamp_closed"
            },
            "judge": {
                "type": "compare",
                "condition": "eq",
                "value": false
            },
            "on_success": [
                { "type": "log", "message": "夹具已打开" }
            ],
            "on_failure": [
                { "type": "log", "message": "夹具未打开" },
                { "type": "popup", "message": "夹具未打开，请检查", "level": "warning" }
            ],
            "on_timeout": [
                { "type": "log", "message": "检查夹具状态超时" }
            ]
        },
        {
            "filename": "check_seal_ring.u8.r_b_seal_ok",
            "name": "检查密封圈是否在位",
            "description": "检查密封圈是否安装到位",
            "params": ["${seal_sensor_register}"],
            "timeout_ms": 1000,
            "max_retries": 3,
            "retry_interval": 500,
            "action": {
                "template": "L1_action/leak_test/all_actions.json/digital_read.u8.r_b_digital_state"
            },
            "judge": {
                "type": "compare",
                "condition": "eq",
                "value": true
            },
            "on_success": [
                { "type": "log", "message": "密封圈在位正常" }
            ],
            "on_failure": [
                { "type": "log", "message": "密封圈未在位" },
                { "type": "popup", "message": "密封圈未安装到位，请检查", "level": "error" }
            ],
            "on_timeout": [
                { "type": "log", "message": "检查密封圈超时" }
            ]
        },
        {
            "filename": "start_air_pump.r_b_pump_start_result",
            "name": "启动气泵",
            "description": "启动气泵建立气源",
            "params": ["${pump_output_register}"],
            "timeout_ms": 3000,
            "max_retries": 3,
            "retry_interval": 500,
            "action": {
                "template": "L1_action/leak_test/all_actions.json/digital_write_on.u8.r_b_write_result"
            },
            "judge": {
                "type": "compare",
                "condition": "eq",
                "value": true
            },
            "on_success": [
                { "type": "log", "message": "气泵已启动" }
            ],
            "on_failure": [
                { "type": "log", "message": "气泵启动失败" },
                { "type": "popup", "message": "气泵启动失败，请检查", "level": "error" }
            ],
            "on_timeout": [
                { "type": "log", "message": "气泵启动超时" }
            ]
        },
        {
            "filename": "clamp_workpiece.r_b_clamp_result",
            "name": "闭合夹具",
            "description": "闭合夹具密封产品",
            "params": [],
            "timeout_ms": 2000,
            "max_retries": 3,
            "retry_interval": 500,
            "action": {
                "template": "L1_action/leak_test/all_actions.json/clamp_close.r_b_clamp_result"
            },
            "judge": {
                "type": "compare",
                "condition": "eq",
                "value": true
            },
            "on_success": [
                { "type": "log", "message": "夹具已闭合" }
            ],
            "on_failure": [
                { "type": "log", "message": "夹具闭合失败" },
                { "type": "popup", "message": "夹具闭合失败，请检查", "level": "error" }
            ],
            "on_timeout": [
                { "type": "log", "message": "夹具闭合超时" }
            ]
        },
        {
            "filename": "check_clamp_closed.r_b_clamp_closed",
            "name": "确认夹具闭合到位",
            "description": "确认夹具是否完全闭合",
            "params": [],
            "timeout_ms": 1000,
            "max_retries": 3,
            "retry_interval": 500,
            "action": {
                "template": "L1_action/leak_test/all_actions.json/check_clamp_closed.r_b_clamp_closed"
            },
            "judge": {
                "type": "compare",
                "condition": "eq",
                "value": true
            },
            "on_success": [
                { "type": "log", "message": "夹具闭合到位" }
            ],
            "on_failure": [
                { "type": "log", "message": "夹具未闭合到位" },
                { "type": "popup", "message": "夹具未闭合到位，请检查", "level": "error" }
            ],
            "on_timeout": [
                { "type": "log", "message": "检查夹具到位超时" }
            ]
        },
        {
            "filename": "open_fill_valve.r_b_valve_result",
            "name": "打开充气阀",
            "description": "打开充气电磁阀",
            "params": [],
            "timeout_ms": 1000,
            "max_retries": 3,
            "retry_interval": 500,
            "action": {
                "template": "L1_action/leak_test/all_actions.json/open_fill_valve.r_b_valve_result"
            },
            "judge": {
                "type": "compare",
                "condition": "eq",
                "value": true
            },
            "on_success": [
                { "type": "log", "message": "充气阀已打开" }
            ],
            "on_failure": [
                { "type": "log", "message": "打开充气阀失败" },
                { "type": "popup", "message": "打开充气阀失败，请检查", "level": "error" }
            ],
            "on_timeout": [
                { "type": "log", "message": "打开充气阀超时" }
            ]
        },
        {
            "filename": "monitor_pressure_rising.u8_f_u16.r_b_pressure_rising",
            "name": "监测压力上升",
            "description": "监测压力是否上升至目标值",
            "params": ["${pressure_channel}", "${target_pressure}", "${fill_timeout}"],
            "timeout_ms": "${fill_timeout}",
            "max_retries": 0,
            "retry_interval": 0,
            "action": {
                "template": "L1_action/leak_test/all_actions.json/read_pressure.u8.r_f_pressure"
            },
            "judge": {
                "type": "compare",
                "condition": "ge",
                "value": "${target_pressure}"
            },
            "on_success": [
                { "type": "log", "message": "压力达到目标值: ${pressure} kPa" }
            ],
            "on_failure": [
                { "type": "log", "message": "压力未达到目标值: ${pressure} kPa" }
            ],
            "on_timeout": [
                { "type": "log", "message": "充气超时" }
            ]
        },
        {
            "filename": "check_large_leak.u8_f_f.r_b_large_leak",
            "name": "检查大漏",
            "description": "检测充气阶段压力上升速率判断大漏",
            "params": ["${pressure_channel}", "${large_leak_threshold}", "${fill_timeout}"],
            "timeout_ms": 1000,
            "max_retries": 3,
            "retry_interval": 500,
            "action": {
                "template": "L1_action/leak_test/all_actions.json/read_pressure.u8.r_f_pressure"
            },
            "judge": {
                "type": "expression",
                "expression": "${pressure} / (${fill_timeout} / 1000) < ${large_leak_threshold}"
            },
            "on_success": [
                { "type": "log", "message": "检测到大漏: 压力上升缓慢" },
                { "type": "popup", "message": "检测到大漏，请检查密封", "level": "error" }
            ],
            "on_failure": [
                { "type": "log", "message": "未检测到大漏，继续充气" }
            ],
            "on_timeout": [
                { "type": "log", "message": "大漏检测超时" }
            ]
        },
        {
            "filename": "close_fill_valve.r_b_valve_result",
            "name": "关闭充气阀",
            "description": "关闭充气电磁阀",
            "params": [],
            "timeout_ms": 1000,
            "max_retries": 3,
            "retry_interval": 500,
            "action": {
                "template": "L1_action/leak_test/all_actions.json/close_fill_valve.r_b_valve_result"
            },
            "judge": {
                "type": "compare",
                "condition": "eq",
                "value": true
            },
            "on_success": [
                { "type": "log", "message": "充气阀已关闭" }
            ],
            "on_failure": [
                { "type": "log", "message": "关闭充气阀失败" },
                { "type": "popup", "message": "关闭充气阀失败，请检查", "level": "error" }
            ],
            "on_timeout": [
                { "type": "log", "message": "关闭充气阀超时" }
            ]
        },
        {
            "filename": "wait.u16.r_b_wait_done",
            "name": "等待",
            "description": "等待指定时间",
            "params": ["${duration}"],
            "timeout_ms": "${duration} + 1000",
            "max_retries": 0,
            "retry_interval": 0,
            "action": {
                "template": "L1_action/control/wait.u16_s.r_b_wait_done"
            },
            "judge": {
                "type": "compare",
                "condition": "eq",
                "value": true
            },
            "on_success": [
                { "type": "log", "message": "等待 ${duration} ms 完成" }
            ],
            "on_failure": [],
            "on_timeout": []
        },
        {
            "filename": "read_stable_pressure.u8.r_f_stable_pressure",
            "name": "读取稳定压力",
            "description": "读取稳定后的压力值 P_start",
            "params": ["${pressure_channel}"],
            "timeout_ms": 1000,
            "max_retries": 3,
            "retry_interval": 500,
            "action": {
                "template": "L1_action/leak_test/all_actions.json/read_pressure.u8.r_f_pressure"
            },
            "judge": {
                "type": "exists"
            },
            "on_success": [
                { "type": "log", "message": "P_start = ${stable_pressure} kPa" }
            ],
            "on_failure": [
                { "type": "log", "message": "读取稳定压力失败" },
                { "type": "popup", "message": "读取稳定压力失败", "level": "error" }
            ],
            "on_timeout": [
                { "type": "log", "message": "读取稳定压力超时" }
            ]
        },
        {
            "filename": "check_pressure_stable.u8_f_u16.r_b_stable",
            "name": "检查压力稳定",
            "description": "检查压力波动是否稳定",
            "params": ["${pressure_channel}", "${stable_threshold}", "${dwell_time}"],
            "timeout_ms": "${dwell_time}",
            "max_retries": 3,
            "retry_interval": 500,
            "action": {
                "template": "L1_action/leak_test/all_actions.json/read_pressure.u8.r_f_pressure"
            },
            "judge": {
                "type": "compare",
                "condition": "le",
                "value": "${stable_threshold}"
            },
            "on_success": [
                { "type": "log", "message": "压力已稳定" }
            ],
            "on_failure": [
                { "type": "log", "message": "压力未稳定" },
                { "type": "popup", "message": "压力未稳定，请检查密封", "level": "warning" }
            ],
            "on_timeout": [
                { "type": "log", "message": "压力稳定等待超时" }
            ]
        },
        {
            "filename": "read_pressure_value.u8.r_f_pressure_value",
            "name": "读取压力值",
            "description": "读取当前压力值",
            "params": ["${pressure_channel}"],
            "timeout_ms": 1000,
            "max_retries": 3,
            "retry_interval": 500,
            "action": {
                "template": "L1_action/leak_test/all_actions.json/read_pressure.u8.r_f_pressure"
            },
            "judge": {
                "type": "exists"
            },
            "on_success": [
                { "type": "log", "message": "当前压力: ${pressure_value} kPa" }
            ],
            "on_failure": [
                { "type": "log", "message": "读取压力失败" }
            ],
            "on_timeout": [
                { "type": "log", "message": "读取压力超时" }
            ]
        },
        {
            "filename": "wait_test_duration.u16.r_b_wait_done",
            "name": "检测计时等待",
            "description": "检测阶段计时",
            "params": ["${test_duration}"],
            "timeout_ms": "${test_duration} + 2000",
            "max_retries": 0,
            "retry_interval": 0,
            "action": {
                "template": "L1_action/control/wait.u16_s.r_b_wait_done"
            },
            "judge": {
                "type": "compare",
                "condition": "eq",
                "value": true
            },
            "on_success": [
                { "type": "log", "message": "检测计时完成" }
            ],
            "on_failure": [],
            "on_timeout": []
        },
        {
            "filename": "read_final_pressure.u8.r_f_final_pressure",
            "name": "读取最终压力",
            "description": "读取检测结束时的压力 P_end",
            "params": ["${pressure_channel}"],
            "timeout_ms": 1000,
            "max_retries": 3,
            "retry_interval": 500,
            "action": {
                "template": "L1_action/leak_test/all_actions.json/read_pressure.u8.r_f_pressure"
            },
            "judge": {
                "type": "exists"
            },
            "on_success": [
                { "type": "log", "message": "P_end = ${final_pressure} kPa" }
            ],
            "on_failure": [
                { "type": "log", "message": "读取最终压力失败" }
            ],
            "on_timeout": [
                { "type": "log", "message": "读取最终压力超时" }
            ]
        },
        {
            "filename": "calculate_delta_p.f_f.r_f_delta_p",
            "name": "计算压降",
            "description": "计算 ΔP = P_start - P_end",
            "params": ["${p_start}", "${p_end}"],
            "timeout_ms": 1000,
            "max_retries": 0,
            "retry_interval": 0,
            "action": {
                "template": "L1_action/leak_test/all_actions.json/calculate_pressure_drop.f_f.r_f_pressure_drop"
            },
            "judge": {
                "type": "exists"
            },
            "on_success": [
                { "type": "log", "message": "ΔP = ${delta_p} kPa" }
            ],
            "on_failure": [
                { "type": "log", "message": "计算压降失败" }
            ],
            "on_timeout": []
        },
        {
            "filename": "calculate_leak_rate.f_f.r_f_leak_rate",
            "name": "计算泄漏率",
            "description": "计算泄漏率 = ΔP / 时间 (kPa/min)",
            "params": ["${delta_p}", "${test_duration}"],
            "timeout_ms": 1000,
            "max_retries": 0,
            "retry_interval": 0,
            "action": {
                "template": "L1_action/leak_test/all_actions.json/calculate_leak_rate.f_f.r_f_leak_rate"
            },
            "judge": {
                "type": "exists"
            },
            "on_success": [
                { "type": "log", "message": "泄漏率 = ${leak_rate} kPa/min" }
            ],
            "on_failure": [
                { "type": "log", "message": "计算泄漏率失败" }
            ],
            "on_timeout": []
        },
        {
            "filename": "check_leak_rate.f_f.r_b_leak_ok",
            "name": "判断泄漏率是否合格",
            "description": "判断泄漏率是否 ≤ 标准值",
            "params": ["${leak_rate}", "${leak_rate_standard}"],
            "timeout_ms": 1000,
            "max_retries": 0,
            "retry_interval": 0,
            "action": {
                "template": "L1_action/leak_test/all_actions.json/calculate.f_f.r_f_calc_result"
            },
            "judge": {
                "type": "compare",
                "condition": "le",
                "value": "${leak_rate_standard}"
            },
            "on_success": [
                { "type": "log", "message": "泄漏率合格: ${leak_rate} ≤ ${leak_rate_standard}" }
            ],
            "on_failure": [
                { "type": "log", "message": "泄漏率不合格: ${leak_rate} > ${leak_rate_standard}" }
            ],
            "on_timeout": []
        },
        {
            "filename": "set_test_result.s.r_b_set_result",
            "name": "设置测试结果",
            "description": "设置测试结果 (PASS/FAIL)",
            "params": ["${result}"],
            "timeout_ms": 1000,
            "max_retries": 0,
            "retry_interval": 0,
            "action": {
                "template": "L1_action/variable/set.s_s"
            },
            "judge": {
                "type": "exists"
            },
            "on_success": [
                { "type": "log", "message": "测试结果已设置为 ${result}" }
            ],
            "on_failure": [
                { "type": "log", "message": "设置测试结果失败" }
            ],
            "on_timeout": []
        },
        {
            "filename": "open_exhaust_valve.r_b_valve_result",
            "name": "打开排气阀",
            "description": "打开排气阀释放压力",
            "params": [],
            "timeout_ms": 1000,
            "max_retries": 3,
            "retry_interval": 500,
            "action": {
                "template": "L1_action/leak_test/all_actions.json/open_exhaust_valve.r_b_valve_result"
            },
            "judge": {
                "type": "compare",
                "condition": "eq",
                "value": true
            },
            "on_success": [
                { "type": "log", "message": "排气阀已打开" }
            ],
            "on_failure": [
                { "type": "log", "message": "打开排气阀失败" },
                { "type": "popup", "message": "打开排气阀失败", "level": "error" }
            ],
            "on_timeout": [
                { "type": "log", "message": "打开排气阀超时" }
            ]
        },
        {
            "filename": "wait_pressure_zero.u8_f_u16.r_b_pressure_zero",
            "name": "等待压力归零",
            "description": "等待压力降至零值以下",
            "params": ["${pressure_channel}", "${zero_threshold}", "${max_wait}"],
            "timeout_ms": "${max_wait}",
            "max_retries": 0,
            "retry_interval": 0,
            "action": {
                "template": "L1_action/leak_test/all_actions.json/read_pressure.u8.r_f_pressure"
            },
            "judge": {
                "type": "compare",
                "condition": "le",
                "value": "${zero_threshold}"
            },
            "on_success": [
                { "type": "log", "message": "压力已归零: ${pressure} kPa" }
            ],
            "on_failure": [
                { "type": "log", "message": "压力未归零: ${pressure} kPa" },
                { "type": "popup", "message": "压力未归零，请检查排气", "level": "warning" }
            ],
            "on_timeout": [
                { "type": "log", "message": "等待压力归零超时" }
            ]
        },
        {
            "filename": "close_exhaust_valve.r_b_valve_result",
            "name": "关闭排气阀",
            "description": "关闭排气阀",
            "params": [],
            "timeout_ms": 1000,
            "max_retries": 3,
            "retry_interval": 500,
            "action": {
                "template": "L1_action/leak_test/all_actions.json/close_exhaust_valve.r_b_valve_result"
            },
            "judge": {
                "type": "compare",
                "condition": "eq",
                "value": true
            },
            "on_success": [
                { "type": "log", "message": "排气阀已关闭" }
            ],
            "on_failure": [
                { "type": "log", "message": "关闭排气阀失败" }
            ],
            "on_timeout": [
                { "type": "log", "message": "关闭排气阀超时" }
            ]
        },
        {
            "filename": "clamp_open_workpiece.r_b_clamp_result",
            "name": "打开夹具",
            "description": "打开夹具释放产品",
            "params": [],
            "timeout_ms": 2000,
            "max_retries": 3,
            "retry_interval": 500,
            "action": {
                "template": "L1_action/leak_test/all_actions.json/clamp_open.r_b_clamp_result"
            },
            "judge": {
                "type": "compare",
                "condition": "eq",
                "value": true
            },
            "on_success": [
                { "type": "log", "message": "夹具已打开" }
            ],
            "on_failure": [
                { "type": "log", "message": "打开夹具失败" },
                { "type": "popup", "message": "打开夹具失败，请手动检查", "level": "error" }
            ],
            "on_timeout": [
                { "type": "log", "message": "打开夹具超时" }
            ]
        },
        {
            "filename": "stop_air_pump.r_b_pump_stop_result",
