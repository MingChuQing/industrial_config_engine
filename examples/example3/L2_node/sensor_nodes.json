{
    "type": "node_bundle",
    "description": "传感器类执行节点集合",
    "version": "1.0.0",
    "nodes": [
        {
            "filename": "check_sensor_triggered.u8.r_b_sensor_triggered",
            "type": "node",
            "name": "检查光电开关是否触发",
            "description": "读取光电开关状态，判断是否触发（值为1）",
            "params": [512],
            "timeout_ms": 2000,
            "max_retries": 0,
            "retry_interval": 0,
            "action": {
                "template": "L1_action/leadshine_actions.json/read_sensor.u8.r_u16_sensor_value"
            },
            "judge": {
                "type": "compare",
                "condition": "eq",
                "value": 1
            },
            "on_success": [
                {
                    "type": "log",
                    "message": "光电开关已触发，值：${sensor_value}"
                }
            ],
            "on_failure": [
                {
                    "type": "log",
                    "message": "光电开关未触发，值：${sensor_value}"
                }
            ],
            "on_timeout": [
                {
                    "type": "log",
                    "message": "检查光电开关超时"
                }
            ]
        },
        {
            "filename": "read_sensor_value.u8.r_u16_sensor_value",
            "type": "node",
            "name": "读取光电开关值",
            "description": "读取光电开关当前数值",
            "params": [512],
            "timeout_ms": 2000,
            "max_retries": 0,
            "retry_interval": 0,
            "action": {
                "template": "L1_action/leadshine_actions.json/read_sensor.u8.r_u16_sensor_value"
            },
            "judge": {
                "type": "exists"
            },
            "on_success": [
                {
                    "type": "log",
                    "message": "光电开关值：${sensor_value}"
                }
            ],
            "on_failure": [
                {
                    "type": "log",
                    "message": "读取光电开关失败"
                }
            ],
            "on_timeout": [
                {
                    "type": "log",
                    "message": "读取光电开关超时"
                }
            ]
        }
    ]
}