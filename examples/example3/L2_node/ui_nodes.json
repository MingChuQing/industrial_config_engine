{
    "type": "node_bundle",
    "description": "UI interaction node collection",
    "version": "1.0.0",
    "nodes": [
        {
            "filename": "popup.s_s",
            "type": "node",
            "name": "popup prompt",
            "description": "show popup message",
            "params": ["message content", "info"],
            "timeout_ms": 5000,
            "max_retries": 0,
            "retry_interval": 0,
            "action": {
                "template": "L1_action/system_actions.json/popup.s_s"
            },
            "judge ": {
                "type": "exists"
            },
            "on_success": [],
            "on_failure": [],
            "on_timeout": [
                {
                    "type": "log",
                    "message": "popup timeout"
                }
            ]
        }
    ]
}