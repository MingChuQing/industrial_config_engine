{
    "type": "node_bundle",
    "description": "UI交互类执行节点集合",
    "version": "1.0.0",
    "nodes": [
        {
            "filename": "popup.s_s",
            "type": "node",
            "name": "弹窗提示",
            "description": "显示弹窗消息",
            "params": ["消息内容", "info"],
            "timeout_ms": 5000,
            "max_retries": 0,
            "retry_interval": 0,
            "action": {
                "template": "L1_action/system_actions.json/popup.s_s"
            },
            "judge": {
                "type": "exists"
            },
            "on_success": [],
            "on_failure": [],
            "on_timeout": [
                {
                    "type": "log",
                    "message": "弹窗超时"
                }
            ]
        }
    ]
}