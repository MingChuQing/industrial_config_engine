{
    "type": "group",
    "name": "Complete Leak testing flow",
    "description": "Complete Leak testing flow from prepare to end",
    "mode": "sequence",
    "max_nodes": 30,
    "delay_between": 0,
    "confirm_between": false,
    "body": [
        {
            "type": "group",
            "name": "Prepare stage",
            "template": "L3_group/leak_test/prepare_stage.group",
            "params": ["${pressure_channel}", "0x0101", "0x0201"]
        },
        {
            "type": "group",
            "name": "Filling stage",
            "template": "L3_group/leak_test/fill_stage.group",
            "params": ["${pressure_channel}", "${target_pressure}", 10000, 5.0]
        },
        {
            "type": "group",
            "name": "Hold stage",
            "template": "L3_group/leak_test/dwell_stage.group",
            "params": ["${pressure_channel}", 5000, 0.1]
        },
        {
            "type": "group",
            "name": "Test stage",
            "template": "L3_group/leak_test/test_stage.group",
            "params": ["${pressure_channel}", "${test_duration}"]
        },
        {
            "type": "group",
            "name": "Judgment stage",
            "template": "L3_group/leak_test/judgment_stage.group",
            "params": ["${leak_rate_standard}", "${product_id}"]
        },
        {
            "type": "group",
            "name": "End stage",
            "template": "L3_group/leak_test/end_stage.group",
            "params": ["${pressure_channel}", "0x0201"]
        }
    ],
    "args": [
        { "index": 0, "name": "product_id", "type": "s", "default": "UNKNOWN", "desc": "product ID" },
        { "index": 1, "name": "target_pressure", "type": "f", "default": 100.0, "desc": "target pressure(kPa)" },
        { "index": 2, "name": "test_duration", "type": "u16", "default": 30000, "desc": "test duration(ms)" },
        { "index": 3, "name": "leak_rate_standard", "type": "f", "default": 0.5, "desc": "leak rate standard(kPa/min)" },
        { "index": 4, "name": "pressure_channel", "type": "u8", "default": 1, "desc": "pressure sensor channel" }
    ]
}