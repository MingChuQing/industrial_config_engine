{
    "type": "group",
    "name": "Leak testingJudgment stage",
    "description": "Judge if leak rate is qualified, output result",
    "mode": "if",
    "max_nodes": 20,
    "condition": {
        "type": "expression",
        "expression": "${leak_rate} <= ${leak_rate_standard}"
    },
    "then": [
        {
            "type": "node",
            "name": "set result PASS",
            "params": ["PASS"],
            "timeout_ms": 1000,
            "max_retries": 0,
            "retry_interval": 0,
            "node": {
                "template": "L2_node/leak_test/all_nodes.json/set_test_result.s.r_b_set_result"
            },
            "on_success": [],
            "on_failure": []
        },
        {
            "type": "node",
            "name": "set green light",
            "params": ["green"],
            "timeout_ms": 1000,
            "max_retries": 3,
            "retry_interval": 500,
            "node": {
                "template": "L2_node/leak_test/all_nodes.json/set_result_led.s.r_b_led_result"
            },
            "on_success": [],
            "on_failure": []
        },
        {
            "type": "node",
            "name": "save PASS record",
            "params": ["${product_id}", "${leak_rate}", "PASS", "${timestamp}"],
            "timeout_ms": 3000,
            "max_retries": 3,
            "retry_interval": 1000,
            "node": {
                "template": "L2_node/leak_test/all_nodes.json/save_test_record.s_f_f_s_s.r_b_save_result"
            },
            "on_success": [],
            "on_failure": []
        },
        {
            "type": "node",
            "name": "show PASS popup",
            "params": ["Leak testingpassed!leak rate=${leak_rate}kPa/min", "success"],
            "timeout_ms": 5000,
            "max_retries": 0,
            "retry_interval": 0,
            "node": {
                "template": "L2_node/leak_test/all_nodes.json/show_result_popup.s_s"
            },
            "on_success": [],
            "on_failure": []
        }
    ],
    "else": [
        {
            "type": "node",
            "name": "set result FAIL",
            "params": ["FAIL"],
            "timeout_ms": 1000,
            "max_retries": 0,
            "retry_interval": 0,
            "node": {
                "template": "L2_node/leak_test/all_nodes.json/set_test_result.s.r_b_set_result"
            },
            "on_success": [],
            "on_failure": []
        },
        {
            "type": "node",
            "name": "set red light",
            "params": ["red"],
            "timeout_ms": 1000,
            "max_retries": 3,
            "retry_interval": 500,
            "node": {
                "template": "L2_node/leak_test/all_nodes.json/set_result_led.s.r_b_led_result"
            },
            "on_success": [],
            "on_failure": []
        },
        {
            "type": "node",
            "name": "buzzer alarm3s",
            "params": [3],
            "timeout_ms": 4000,
            "max_retries": 3,
            "retry_interval": 500,
            "node": {
                "template": "L2_node/leak_test/all_nodes.json/beep_alert.u8.r_b_beep_result"
            },
            "on_success": [],
            "on_failure": []
        },
        {
            "type": "node",
            "name": "save FAIL record",
            "params": ["${product_id}", "${leak_rate}", "FAIL", "${timestamp}"],
            "timeout_ms": 3000,
            "max_retries": 3,
            "retry_interval": 1000,
            "node": {
                "template": "L2_node/leak_test/all_nodes.json/save_test_record.s_f_f_s_s.r_b_save_result"
            },
            "on_success": [],
            "on_failure": []
        },
        {
            "type": "node",
            "name": "show FAIL popup",
            "params": ["Leak testingfailed!leak rate=${leak_rate}kPa/min, standard <=${leak_rate_standard}", "error"],
            "timeout_ms": 5000,
            "max_retries": 0,
            "retry_interval": 0,
            "node": {
                "template": "L2_node/leak_test/all_nodes.json/show_result_popup.s_s"
            },
            "on_success": [],
            "on_failure": []
        }
    ],
    "args": [
        { "index": 0, "name": "leak_rate_standard", "type": "f", "default": 0.5, "desc": "leak rate standard(kPa/min)" },
        { "index": 1, "name": "product_id", "type": "s", "default": "UNKNOWN", "desc": "product ID" }
    ]
}