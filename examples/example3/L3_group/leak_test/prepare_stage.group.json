{
    "type": "group",
    "name": "Leak test - preparation stage",
    "description": "Check air/ring, clamp, start pump",
    "mode": "sequence",
    "max_nodes": 20,
    "delay_between": 500,
    "confirm_between": false,
    "body": [
        {
            "type": "node",
            "name": "Check air pressure",
            "params": ["${pressure_channel}"],
            "timeout_ms": 2000,
            "max_retries": 3,
            "retry_interval": 500,
            "node": {
                "template": "L2_node/leak_test/all_nodes.json/check_air_pressure.u8.r_b_air_ok"
            },
            "on_success": [],
            "on_failure": []
        },
        {
            "type": "node",
            "name": "check fixture open",
            "params": [],
            "timeout_ms": 1000,
            "max_retries": 3,
            "retry_interval": 500,
            "node": {
                "template": "L2_node/leak_test/all_nodes.json/check_clamp_open.r_b_clamp_open_ok"
            },
            "on_success": [],
            "on_failure": []
        },
        {
            "type": "node",
            "name": "check seal ring in place",
            "params": ["${seal_sensor_register}"],
            "timeout_ms": 1000,
            "max_retries": 3,
            "retry_interval": 500,
            "node": {
                "template": "L2_node/leak_test/all_nodes.json/check_seal_ring.u8.r_b_seal_ok"
            },
            "on_success": [],
            "on_failure": []
        },
        {
            "type": "node",
            "name": "start pump",
            "params": ["${pump_output_register}"],
            "timeout_ms": 3000,
            "max_retries": 3,
            "retry_interval": 500,
            "node": {
                "template": "L2_node/leak_test/all_nodes.json/start_air_pump.r_b_pump_start_result"
            },
            "on_success": [],
            "on_failure": []
        },
        {
            "type": "node",
            "name": "close fixture",
            "params": [],
            "timeout_ms": 2000,
            "max_retries": 3,
            "retry_interval": 500,
            "node": {
                "template": "L2_node/leak_test/all_nodes.json/clamp_workpiece.r_b_clamp_result"
            },
            "on_success": [],
            "on_failure": []
        },
        {
            "type": "node",
            "name": "confirm fixture fully closed",
            "params": [],
            "timeout_ms": 1000,
            "max_retries": 3,
            "retry_interval": 500,
            "node": {
                "template": "L2_node/leak_test/all_nodes.json/check_clamp_closed.r_b_clamp_closed"
            },
            "on_success": [],
            "on_failure": []
        }
    ],
    "args": [
        { "index": 0, "name": "pressure_channel", "type": "u8", "default": 1, "desc": "pressure sensor channel" },
        { "index": 1, "name": "seal_sensor_register", "type": "u8", "default": "0x0101", "desc": "seal sensor register" },
        { "index": 2, "name": "pump_output_register", "type": "u8", "default": "0x0201", "desc": "pump control output" }
    ]
}