{
    "type": "group",
    "name": "气密性检测充气阶段",
    "description": "打开充气阀，充气至目标压力，检测大漏",
    "mode": "loop",
    "max_nodes": 20,
    "loop": {
        "type": "while",
        "condition": "${pressure_rising} == false && ${large_leak} == false",
        "max_iterations": 200
    },
    "body": [
        {
            "type": "node",
            "name": "打开充气阀",
            "params": [],
            "timeout_ms": 1000,
            "max_retries": 3,
            "retry_interval": 500,
            "node": {
                "template": "L2_node/leak_test/all_nodes.json/open_fill_valve.r_b_valve_result"
            },
            "on_success": [],
            "on_failure": []
        },
        {
            "type": "node",
            "name": "监测压力上升",
            "params": ["${pressure_channel}", "${target_pressure}", "${fill_timeout}"],
            "timeout_ms": "${fill_timeout}",
            "max_retries": 0,
            "retry_interval": 0,
            "node": {
                "template": "L2_node/leak_test/all_nodes.json/monitor_pressure_rising.u8_f_u16.r_b_pressure_rising"
            },
            "judge": {
                "type": "compare",
                "condition": "eq",
                "value": true
            },
            "on_success": [
                { "type": "log", "message": "充气完成" }
            ],
            "on_failure": [
                { "type": "log", "message": "充气失败，继续检查大漏" }
            ]
        },
        {
            "type": "node",
            "name": "检查大漏",
            "params": ["${pressure_channel}", "${large_leak_threshold}", "${fill_timeout}"],
            "timeout_ms": 1000,
            "max_retries": 3,
            "retry_interval": 500,
            "node": {
                "template": "L2_node/leak_test/all_nodes.json/check_large_leak.u8_f_f.r_b_large_leak"
            },
            "judge": {
                "type": "compare",
                "condition": "eq",
                "value": true
            },
            "on_success": [
                { "type": "log", "message": "检测到大漏" }
            ],
            "on_failure": []
        },
        {
            "type": "node",
            "name": "等待100ms",
            "params": [100],
            "timeout_ms": 2000,
            "max_retries": 0,
            "retry_interval": 0,
            "node": {
                "template": "L2_node/wait/wait_ms.u16.r_b_wait_done"
            },
            "on_success": [],
            "on_failure": []
        }
    ],
    "args": [
        { "index": 0, "name": "pressure_channel", "type": "u8", "default": 1, "desc": "压力传感器通道" },
        { "index": 1, "name": "target_pressure", "type": "f", "default": 100.0, "desc": "目标压力(kPa)" },
        { "index": 2, "name": "fill_timeout", "type": "u16", "default": 10000, "desc": "充气超时(ms)" },
        { "index": 3, "name": "large_leak_threshold", "type": "f", "default": 5.0, "desc": "大漏阈值(kPa/s)" }
    ]
}