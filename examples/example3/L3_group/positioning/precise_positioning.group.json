{
    "type": "group",
    "name": "PR precise positioning",
    "description": "Run PR -> jog to sensor -> save precise position",
    "mode": "sequence",
    "max_nodes": 30,
    "timeout_ms": 90000,
    "args": [
        { "index": 0, "name": "pr_number", "type": "u8", "desc": "PR point number" },
        { "index": 1, "name": "sensor_register", "type": "u8", "desc": "photoelectric switch register address" },
        { "index": 2, "name": "result_key", "type": "s", "desc": "variable name for result" },
        { "index": 3, "name": "timeout", "type": "u16", "default": 30000, "desc": "timeout(ms)" }
    ],
    "body": [
        {
            "type": "group",
            "template": "L3_group/positioning/run_pr_with_wait.group.json",
            "params": ["${pr_number}", "${timeout}"]
        },
        {
            "type": "group",
            "template": "L3_group/positioning/jog_find_sensor.group.json",
            "params": ["${sensor_register}", "${timeout}"]
        },
        {
            "type": "node",
            "template": "L2_node/variable_nodes.json/set_variable.s_s",
            "params": ["${result_key}", "${current_position}"]
        },
        {
            "type": "node",
            "template": "L2_node/log_nodes.json/print.s",
            "params": ["PR${pr_number} done, saved to ${result_key}: ${current_position}"]
        }
    ],
    "on_timeout": [
        { "type": "log", "message": "PR${pr_number} positioning timeout" },
        { "type": "popup", "message": "PR${pr_number} positioning timeout", "level": "error" }
    ]
}
