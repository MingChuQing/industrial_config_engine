{
    "type": "group",
    "name": "Jog to find sensor",
    "description": "Jog forward until sensor triggers, return precise position",
    "mode": "sequence",
    "max_nodes": 30,
    "timeout_ms": 60000,
    "args": [
        { "index": 0, "name": "sensor_register", "type": "u8", "desc": "photoelectric switch register address" },
        { "index": 1, "name": "timeout", "type": "u16", "default": 10000, "desc": "timeout(ms)" }
    ],
    "body": [
        {
            "type": "node",
            "template": "L2_node/leadshine_nodes.json/start_jog.u16.r_b_jog_start_result",
            "params": [10]
        },
        {
            "type": "group",
            "name": "Loop sensor detection",
            "mode": "loop",
            "max_nodes": 20,
            "timeout_ms": "${timeout}",
            "loop": {
                "type": "do-while",
                "condition": "${sensor_triggered} != true"
            },
            "body": [
                {
                    "type": "node",
                    "template": "L2_node/sensor_nodes.json/check_sensor_triggered.u8.r_b_sensor_triggered",
                    "params": ["${sensor_register}"]
                },
                {
                    "type": "node",
                    "template": "L2_node/wait_nodes.json/wait_ms.u16.r_b_wait_done",
                    "params": [50]
                }
            ],
            "on_success": [
                { "type": "log", "message": "Sensor triggered" }
            ],
            "on_timeout": [
                { "type": "log", "message": "Sensor detection timeout" },
                {
                    "type": "node",
                    "template": "L2_node/leadshine_nodes.json/stop_jog.r_b_jog_stop_result",
                    "params": []
                },
                { "type": "popup", "message": "Sensor not triggered", "level": "error" }
            ]
        },
        {
            "type": "node",
            "template": "L2_node/leadshine_nodes.json/stop_jog.r_b_jog_stop_result",
            "params": []
        },
        {
            "type": "node",
            "template": "L2_node/leadshine_nodes.json/read_current_position.r_i32_current_position",
            "params": []
        }
    ],
    "on_timeout": [
        { "type": "log", "message": "Jog to find sensorgroup timeout" },
        {
            "type": "node",
            "template": "L2_node/leadshine_nodes.json/stop_jog.r_b_jog_stop_result",
            "params": []
        },
        { "type": "popup", "message": "Jog to find sensortimeout", "level": "error" }
    ]
}