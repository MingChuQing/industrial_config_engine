{
    "type": "flow",
    "name": "Leak test production flow",
    "description": "Complete Leak test production flow",
    "version": "1.0.0",
    "max_depth": 10,
    "body": [
        {
            "type": "group",
            "name": "Feed: pick product",
            "template": "L3_group/positioning/precise_positioning.group",
            "params": [1, 512, "pick_position", 30000]
        },
        {
            "type": "group",
            "name": "Feed: place product to test station",
            "template": "L3_group/positioning/precise_positioning.group",
            "params": [2, 512, "place_position", 30000]
        },
        {
            "type": "node",
            "name": "Notify start of test",
            "params": ["Product placed, start leak test"],
            "node": {
                "template": "L2_node/log_nodes.json/print.s"
            },
            "on_success": [],
            "on_failure": []
        },
        {
            "type": "group",
            "name": "Leak testing",
            "template": "L3_group/leak_test/complete_leak_test.group",
            "params": ["${product_id}", 100.0, 30000, 0.5, 1]
        },
        {
            "type": "if",
            "name": "Sort by test result",
            "condition": {
                "type": "expression",
                "expression": "${test_result} == 'PASS'"
            },
            "then": [
                {
                    "type": "group",
                    "name": "Move to PASS area",
                    "template": "L3_group/positioning/precise_positioning.group",
                    "params": [3, 512, "pass_position", 30000]
                },
                {
                    "type": "node",
                    "name": "record qualified product",
                    "params": ["Product ${product_id} PASS, moved to pass area"],
                    "node": {
                        "template": "L2_node/log_nodes.json/print.s"
                    },
                    "on_success": [],
                    "on_failure": []
                }
            ],
            "else": [
                {
                    "type": "group",
                    "name": "Move to FAIL area",
                    "template": "L3_group/positioning/precise_positioning.group",
                    "params": [4, 512, "fail_position", 30000]
                },
                {
                    "type": "node",
                    "name": "record unqualified product",
                    "params": ["Product ${product_id} FAIL, moved to fail area"],
                    "node": {
                        "template": "L2_node/log_nodes.json/print.s"
                    },
                    "on_success": [],
                    "on_failure": []
                }
            ]
        }
    ]
}
