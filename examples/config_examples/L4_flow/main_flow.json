{
    "type": "flow",
    "name": "主生产流程",
    "description": " 步进电机测试流程",
    "version": "1.0.0",
    "timeout_ms": 60000,
    "profiles": {
        "production": {
            "description": "生产模式",
            "params": {
                "target_axis": "X_Axis"
            }
        }
    },
    "active_profile": "production",
    "body": [
        {
            "type": "group",
            "name": "步骤1：使能电机",
            "template": "L3_group/motor_enable.group",
            "params": ["${profile.target_axis}"]
        },
        {
            "type": "group",
            "name": "步骤2：电机回零（带超时检测）",
            "template": "L3_group/motor_homing_with_timeout.group",
            "params": ["${profile.target_axis}"]
        },
        {
            "type": "group",
            "name": "步骤3：读取最终状态",
            "template": "L3_group/read_status.group",
            "params": ["${profile.target_axis}"]
        }
    ]
}