{
    "type": "flow",
    "name": "Main production flow",
    "description": " stepper motor test flow",
    "version": "1.0.0",
    "timeout_ms": 60000,
    "profiles": {
        "production": {
            "description": "production mode",
            "params": {
                "target_axis": "X_Axis"
            }
        }
    },
    "active_profile": "production",
    "body": [
        {
            "type": "group",
            "name": "Step 1: enable motor",
            "template": "L3_group/motor_enable.group",
            "params": ["${profile.target_axis}"]
        },
        {
            "type": "group",
            "name": "Step 2: Motor homing (with timeout check)",
            "template": "L3_group/motor_homing_with_timeout.group",
            "params": ["${profile.target_axis}"]
        },
        {
            "type": "group",
            "name": "Step 3: read final status",
            "template": "L3_group/read_status.group",
            "params": ["${profile.target_axis}"]
        }
    ]
}