{
    "type": "node_bundle",
    "description": "  iDM 系列步进电机 L2 执行节点集合 v2.0",
    "version": "2.0.0",
    "nodes": [
        {
            "filename": "motor_enable.r_b_enable_result",
            "name": "电机使能",
            "description": "使能指定的步进电机",
            "params": [ "${instance_id}" ],
            "timeout_ms": 3000,
            "max_retries": 3,
            "retry_interval": 500,
            "action": {
                "template": "L1_action/modbus/iDM_actions.json/motor_enable.r_b_enable_result"
            },
            "judge": {
                "type": "compare",
                "condition": "eq",
                "value": true
            },
            "on_success": [
                {
                    "template": "L1_action/modbus/iDM_actions.json/log.s",
                    "params": [ "电机 ${instance_id} 使能成功" ]
                },
                {
                    "template": "L1_action/modbus/iDM_actions.json/popup.s_s",
                    "params": [ "电机 ${instance_id} 已使能", "info" ]
                }
            ],
            "on_failure": [
                {
                    "template": "L1_action/modbus/iDM_actions.json/log.s",
                    "params": [ "电机 ${instance_id} 使能失败" ]
                },
                {
                    "template": "L1_action/modbus/iDM_actions.json/popup.s_s",
                    "params": [ "电机 ${instance_id} 使能失败，请检查参数", "error" ]
                }
            ],
            "on_timeout": [
                {
                    "template": "L1_action/modbus/iDM_actions.json/log.s",
                    "params": [ "电机 ${instance_id} 使能超时" ]
                },
                {
                    "template": "L1_action/modbus/iDM_actions.json/popup.s_s",
                    "params": [ "电机 ${instance_id} 使能超时，请检查通信", "error" ]
                }
            ]
        },
        {
            "filename": "motor_disable.r_b_disable_result",
            "name": "电机关闭使能",
            "description": "关闭指定步进电机的使能",
            "params": [ "${instance_id}" ],
            "timeout_ms": 3000,
            "max_retries": 0,
            "retry_interval": 0,
            "action": {
                "template": "L1_action/modbus/iDM_actions.json/motor_disable.r_b_disable_result"
            },
            "judge": {
                "type": "compare",
                "condition": "eq",
                "value": true
            },
            "on_success": [
                {
                    "template": "L1_action/modbus/iDM_actions.json/log.s",
                    "params": [ "电机 ${instance_id} 关闭使能成功" ]
                }
            ],
            "on_failure": [
                {
                    "template": "L1_action/modbus/iDM_actions.json/log.s",
                    "params": [ "电机 ${instance_id} 关闭使能失败" ]
                },
                {
                    "template": "L1_action/modbus/iDM_actions.json/popup.s_s",
                    "params": [ "关闭使能失败", "warning" ]
                }
            ],
            "on_timeout": [
                {
                    "template": "L1_action/modbus/iDM_actions.json/log.s",
                    "params": [ "电机 ${instance_id} 关闭使能超时" ]
                },
                {
                    "template": "L1_action/modbus/iDM_actions.json/popup.s_s",
                    "params": [ "关闭使能超时，请检查通信", "warning" ]
                }
            ]
        },
        {
            "filename": "read_status.r_u16_motor_status",
            "name": "读取运行状态",
            "description": "读取电机的运行状态 (0x1003)",
            "params": [ "${instance_id}" ],
            "timeout_ms": 2000,
            "max_retries": 3,
            "retry_interval": 500,
            "action": {
                "template": "L1_action/modbus/iDM_actions.json/read_status.r_u16_motor_status"
            },
            "judge": {
                "type": "exists"
            },
            "on_success": [
                {
                    "template": "L1_action/modbus/iDM_actions.json/log.s",
                    "params": [ "${instance_id} 状态: ${motor_status} (bit0=故障, bit1=使能, bit2=运行, bit4=指令完成, bit5=路径完成, bit6=回零完成)" ]
                }
            ],
            "on_failure": [
                {
                    "template": "L1_action/modbus/iDM_actions.json/log.s",
                    "params": [ "${instance_id} 状态读取失败" ]
                },
                {
                    "template": "L1_action/modbus/iDM_actions.json/popup.s_s",
                    "params": [ "读取状态失败", "warning" ]
                }
            ],
            "on_timeout": [
                {
                    "template": "L1_action/modbus/iDM_actions.json/log.s",
                    "params": [ "${instance_id} 状态读取超时" ]
                },
                {
                    "template": "L1_action/modbus/iDM_actions.json/popup.s_s",
                    "params": [ "读取状态超时，电机可能离线", "warning" ]
                }
            ]
        },
        {
            "filename": "read_alarm.r_u16_alarm_code",
            "name": "读取当前报警",
            "description": "读取电机的当前报警码 (0x2203)",
            "params": [ "${instance_id}" ],
            "timeout_ms": 2000,
            "max_retries": 3,
            "retry_interval": 500,
            "action": {
                "template": "L1_action/modbus/iDM_actions.json/read_alarm.r_u16_alarm_code"
            },
            "judge": {
                "type": "compare",
                "condition": "eq",
                "value": 0
            },
            "on_success": [
                {
                    "template": "L1_action/modbus/iDM_actions.json/log.s",
                    "params": [ "${instance_id} 无报警" ]
                }
            ],
            "on_failure": [
                {
                    "template": "L1_action/modbus/iDM_actions.json/log.s",
                    "params": [ "${instance_id} 报警码: ${alarm_code}" ]
                },
                {
                    "template": "L1_action/modbus/iDM_actions.json/popup.s_s",
                    "params": [ "电机报警: ${alarm_code}", "error" ]
                }
            ],
            "on_timeout": [
                {
                    "template": "L1_action/modbus/iDM_actions.json/log.s",
                    "params": [ "${instance_id} 读取报警超时" ]
                },
                {
                    "template": "L1_action/modbus/iDM_actions.json/popup.s_s",
                    "params": [ "读取报警超时，请检查通信", "warning" ]
                }
            ]
        },
        {
            "filename": "reset_alarm.r_b_reset_result",
            "name": "复位当前报警",
