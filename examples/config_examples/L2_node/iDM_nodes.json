        {
            "filename": "read_status.r_u16_motor_status",
            "name": "read running status",
            "description": "read motor running status (0x1003)",
            "params": [ "${instance_id}" ],
            "timeout_ms": 2000,
            "max_retries": 3,
            "retry_interval": 500,
            "action": {
                "template": "L1_action/modbus/iDM_actions.json/read_status.r_u16_motor_status"
            },
            "judge ": {
                "type": "exists"
            },
            "on_success": [
                {
                    "template": "L1_action/modbus/iDM_actions.json/log.s",
                    "params": [ "${instance_id} status: ${motor_status} (bit0=fault, bit1=enable, bit2=run, bit4=commanddone, bit5=path done, bit6=homing done)" ]
                }
            ],
            "on_failure": [
                {
                    "template": "L1_action/modbus/iDM_actions.json/log.s",
                    "params": [ "${instance_id} status read failed" ]
