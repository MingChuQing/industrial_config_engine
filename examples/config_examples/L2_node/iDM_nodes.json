{
    "type": "node_bundle",
    "description": "  iDM series stepper motor L2 node collection v2.0",
    "version": "2.0.0",
    "nodes": [
        {
            "filename": "motor_enable.r_b_enable_result",
            "name": "motor enable",
            "description": "enable specified stepper motor",
            "params": [ "${instance_id}" ],
            "timeout_ms": 3000,
            "max_retries": 3,
            "retry_interval": 500,
            "action": {
                "template": "L1_action/modbus/iDM_actions.json/motor_enable.r_b_enable_result"
            },
            "judge ": {
                "type": "compare",
                "condition": "eq",
                "value": true
            },
            "on_success": [
                {
                    "template": "L1_action/modbus/iDM_actions.json/log.s",
                    "params": [ "motor ${instance_id} enable success" ]
                },
                {
                    "template": "L1_action/modbus/iDM_actions.json/popup.s_s",
                    "params": [ "motor ${instance_id} enabled", "info" ]
                }
            ],
            "on_failure": [
                {
                    "template": "L1_action/modbus/iDM_actions.json/log.s",
                    "params": [ "motor ${instance_id} enable failed" ]
                },
                {
                    "template": "L1_action/modbus/iDM_actions.json/popup.s_s",
                    "params": [ "motor ${instance_id} enablefailed, check parameters", "error" ]
                }
            ],
            "on_timeout": [
                {
                    "template": "L1_action/modbus/iDM_actions.json/log.s",
                    "params": [ "motor ${instance_id} enable timeout" ]
                },
                {
                    "template": "L1_action/modbus/iDM_actions.json/popup.s_s",
                    "params": [ "motor ${instance_id} enabletimeout, check communication", "error" ]
                }
            ]
        },
        {
            "filename": "motor_disable.r_b_disable_result",
            "name": "motor disable",
            "description": "disable specified stepper motor",
            "params": [ "${instance_id}" ],
            "timeout_ms": 3000,
            "max_retries": 0,
            "retry_interval": 0,
