            "filename": "reset_to_default.r_b_default_result",
            "name": "factory reset",
            "description": "restore motor factory settings (0x1801 = 0x2233)",
            "params": [ "${instance_id}" ],
            "timeout_ms": 5000,
            "max_retries": 3,
            "retry_interval": 1000,
            "action": {
                "type": "modbus_write_verify",
                "protocol": "modbus",
                "request": "06 18 01 22 33",
                "response": "06 18 01 22 33",
                "timeout_ms": 5000,
                "description": "factory reset (0x1801 = 0x2233)"
            },
            "judge ": {
                "type": "compare",
                "condition": "eq",
                "value": true
            },
            "on_success": [
                {
                    "type": "log",
                    "message": "${instance_id} factory reset done"
                },
                {
                    "type": "popup",
                    "message": "factory reset success, , please power-cycle",
                    "level": "warning"
                }
            ],
            "on_failure": [
                {
                    "type": "log",
                    "message": "${instance_id} factory reset failed"
                },
                {
                    "type": "popup",
                    "message": "factory reset failed",
                    "level": "error"
                }
            ],
            "on_timeout": [
                {
                    "type": "log",
                    "message": "${instance_id} factory reset timeout"
                },
                {
                    "type": "popup",
                    "message": "factory resettimeout, check communication",    
                    "level": "error"
                },
                {
                    "type": "popup",
                    "message": "If no response for a long time, restart motor manually",
                    "level": "warning"
                }
            ]
        }
