{
    "type": "group",
    "name": "Motor enable group",
    "description": "enable specified motor",
    "mode": "sequence",
    "max_nodes": 5,
    "body": [
        {
            "type": "node",
            "name": "enable motor",
            "result_key": "enable_result",
            "params": {
                "instance_id": "${instance_id}"
            },
            "timeout_ms": 3000,
            "max_retries": 3,
            "retry_interval": 500,
            "node": {
                "template": "L2_node/motor_enable.r_b_enable_result"
            },
            "judge ": {
                "type": "compare",
                "condition": "eq",
                "value": true
            },
            "on_success": [
                {
                    "type": "log",
                    "message": "motor ${instance_id} enable success"
                },
                {
                    "type": "popup",
                    "message": "motor ${instance_id} enabled",
                    "level": "info"
                }
            ],
            "on_failure": [
                {
                    "type": "log",
                    "message": "motor ${instance_id} enable failed"
                },
                {
                    "type": "popup",
                    "message": "motor ${instance_id} enablefailed, check communication",
                    "level": "error"
                }
            ]
        }
    ],
    "args": [
        {
            "index": 0,
            "name": "instance_id",
            "type": "s",
            "desc": "device instance ID"
        }
    ]
}
