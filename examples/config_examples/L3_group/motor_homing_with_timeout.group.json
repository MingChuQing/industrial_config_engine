{
    "type": "group",
    "name": "Motor homing (with timeout check)",
    "description": "trigger motor homing, loop check statusuntildoneor 30 s timeout",
    "mode": "sequence",
    "max_nodes": 10,
    "delay_between": 0,
    "confirm_between": false,
    "body": [
        {
            "type": "node",
            "name": "set homing mode",
            "description": "set to origin homing mode (0x600A = 0x0002)",
            "params": {
                "instance_id": "${instance_id}",
                "mode": "0x0002"
            },
            "timeout_ms": 3000,
            "max_retries": 3,
            "retry_interval": 500,
            "node": {
                "template": "L2_node/set_homing_mode.u16.r_b_mode_result"
            },
            "judge ": {
                "type": "compare",
                "condition": "eq",
                "value": true
            },
            "on_success": [
                {
                    "type": "log",
                    "message": "${instance_id} homing mode set (origin homing)"
                }
            ],
            "on_failure": [
                {
                    "type": "log",
                    "message": "${instance_id} homing mode set failed"
                },
                {
                    "type": "popup",
                    "message": "homing mode set failed, check communication",
                    "level": "error"
                }
            ]
        },
        {
            "type": "node",
            "name": "trigger homing",
            "description": "send homing trigger command (0x6002 = 0x0020)",
            "params": {
                "instance_id": "${instance_id}"
            },
            "timeout_ms": 3000,
            "max_retries": 3,
            "retry_interval": 500,
            "node": {
                "template": "L2_node/trigger_homing.r_b_homing_result"
            },
            "judge ": {
                "type": "compare",
                "condition": "eq",
                "value": true
            },
            "on_success": [
                {
                    "type": "log",
                    "message": "${instance_id} homing triggered"
                },
                {
                    "type": "ui_action",
                    "action": "update_status",
                    "data": {
                        "text": "homing...",
                        "color": "yellow"
                    }
                }
            ],
            "on_failure": [
                {
                    "type": "log",
                    "message": "${instance_id} homing trigger failed"
                },
                {
                    "type": "popup",
                    "message": "homingtrigger failed, check communication",
                    "level": "error"
                }
            ]
        },
        {
            "type": "node",
            "name": "Wait homing done (loop check, 30 s timeout)",
            "description": "loop read running status (0x1003), check  Bit6(homing done)",
            "params": {
                "instance_id": "${instance_id}"
            },
            "timeout_ms": 30000,
            "max_retries": 30,
            "retry_interval": 1000,
            "node": {
                "template": "L2_node/read_status.r_u16_motor_status"
            },
            "judge ": {
                "type": "expression",
                "expression": "(${motor_status} & 0x40) != 0"
            },
            "on_success": [
                {
                    "type": "log",
                    "message": "${instance_id} homingdone! status: ${motor_status}"
                },
                {
                    "type": "ui_action",
                    "action": "update_status",
                    "data": {
                        "text": "homing done",
                        "color": "green"
                    }
                },
                {
                    "type": "popup",
                    "message": "motor ${instance_id} homing done",
                    "level": "info"
                }
            ],
            "on_failure": [
                {
                    "type": "log",
                    "message": "${instance_id} homing timeout (30 s), current status: ${motor_status}"
                },
                {
                    "type": "ui_action",
                    "action": "update_status",
                    "data": {
                        "text": "homing timeout",
                        "color": "red"
                    }
                },
                {
                    "type": "popup",
                    "message": "motor ${instance_id} homing timeout！, check mechanics or sensor",
                    "level": "error"
                }
            ]
        }
    ],
    "args": [
        {
            "index": 0,
            "name": "instance_id",
            "type": "s",
            "desc": "device instance ID (e.g. X_Axis, Y_Axis)"
        }
    ]
}