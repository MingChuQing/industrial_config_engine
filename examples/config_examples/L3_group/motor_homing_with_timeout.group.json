{
    "type": "group",
    "name": "电机回零（带超时检测）",
    "description": "触发电机回零，循环检测状态直到完成或30秒超时",
    "mode": "sequence",
    "max_nodes": 10,
    "delay_between": 0,
    "confirm_between": false,
    "body": [
        {
            "type": "node",
            "name": "设置回零模式",
            "description": "设置为原点回零模式 (0x600A = 0x0002)",
            "params": {
                "instance_id": "${instance_id}",
                "mode": "0x0002"
            },
            "timeout_ms": 3000,
            "max_retries": 3,
            "retry_interval": 500,
            "node": {
                "template": "L2_node/set_homing_mode.u16.r_b_mode_result"
            },
            "judge": {
                "type": "compare",
                "condition": "eq",
                "value": true
            },
            "on_success": [
                {
                    "type": "log",
                    "message": "${instance_id} 回零模式已设置（原点回零）"
                }
            ],
            "on_failure": [
                {
                    "type": "log",
                    "message": "${instance_id} 回零模式设置失败"
                },
                {
                    "type": "popup",
                    "message": "回零模式设置失败，请检查通信",
                    "level": "error"
                }
            ]
        },
        {
            "type": "node",
            "name": "触发回零",
            "description": "发送回零触发命令 (0x6002 = 0x0020)",
            "params": {
                "instance_id": "${instance_id}"
            },
            "timeout_ms": 3000,
            "max_retries": 3,
            "retry_interval": 500,
            "node": {
                "template": "L2_node/trigger_homing.r_b_homing_result"
            },
            "judge": {
                "type": "compare",
                "condition": "eq",
                "value": true
            },
            "on_success": [
                {
                    "type": "log",
                    "message": "${instance_id} 回零已触发"
                },
                {
                    "type": "ui_action",
                    "action": "update_status",
                    "data": {
                        "text": "回零中...",
                        "color": "yellow"
                    }
                }
            ],
            "on_failure": [
                {
                    "type": "log",
                    "message": "${instance_id} 回零触发失败"
                },
                {
                    "type": "popup",
                    "message": "回零触发失败，请检查通信",
                    "level": "error"
                }
            ]
        },
        {
            "type": "node",
            "name": "等待回零完成（循环检测，30秒超时）",
            "description": "循环读取运行状态 (0x1003)，检查 Bit6（回零完成）",
            "params": {
                "instance_id": "${instance_id}"
            },
            "timeout_ms": 30000,
            "max_retries": 30,
            "retry_interval": 1000,
            "node": {
                "template": "L2_node/read_status.r_u16_motor_status"
            },
            "judge": {
                "type": "expression",
                "expression": "(${motor_status} & 0x40) != 0"
            },
            "on_success": [
                {
                    "type": "log",
                    "message": "${instance_id} 回零完成！状态: ${motor_status}"
                },
                {
                    "type": "ui_action",
                    "action": "update_status",
                    "data": {
                        "text": "回零完成",
                        "color": "green"
                    }
                },
                {
                    "type": "popup",
                    "message": "电机 ${instance_id} 回零完成",
                    "level": "info"
                }
            ],
            "on_failure": [
                {
                    "type": "log",
                    "message": "${instance_id} 回零超时（30秒），当前状态: ${motor_status}"
                },
                {
                    "type": "ui_action",
                    "action": "update_status",
                    "data": {
                        "text": "回零超时",
                        "color": "red"
                    }
                },
                {
                    "type": "popup",
                    "message": "电机 ${instance_id} 回零超时！请检查机械或传感器",
                    "level": "error"
                }
            ]
        }
    ],
    "args": [
        {
            "index": 0,
            "name": "instance_id",
            "type": "s",
            "desc": "设备实例 ID（如 X_Axis、Y_Axis）"
        }
    ]
}