{
    "type": "group",
    "name": "Read status group",
    "description": "read specified motor running status",
    "mode": "sequence",
    "max_nodes": 5,
    "delay_between": 0,
    "confirm_between": false,
    "body": [
        {
            "type": "node",
            "name": "read status",
            "result_key": "status_result",
            "params": {
                "instance_id": "${instance_id}"
            },
            "timeout_ms": 2000,
            "max_retries": 3,
            "retry_interval": 500,
            "node": {
                "template": "L2_node/read_status.r_u16_motor_status"
            },
            "judge ": {
                "type": "exists"
            },
            "on_success": [
                {
                    "type": "log",
                    "message": "motor ${instance_id} status: ${status_result}"
                },
                {
                    "type": "ui_action",
                    "action": "update_status",
                    "data": {
                        "text": "status: ${status_result}",
                        "color": "blue"
                    }
                }
            ],
            "on_failure": [
                {
                    "type": "log",
                    "message": "motor ${instance_id} status read failed"
                },
                {
                    "type": "popup",
                    "message": "read statusfailed, check communication",
                    "level": "warning"
                }
            ]
        }
    ],
    "args": [
        {
            "index": 0,
            "name": "instance_id",
            "type": "s",
            "desc": "device instance ID"
        }
    ]
}