{
    "type": "group",
    "name": "读取状态组",
    "description": "读取指定电机的运行状态",
    "mode": "sequence",
    "max_nodes": 5,
    "delay_between": 0,
    "confirm_between": false,
    "body": [
        {
            "type": "node",
            "name": "读取状态",
            "result_key": "status_result",
            "params": {
                "instance_id": "${instance_id}"
            },
            "timeout_ms": 2000,
            "max_retries": 3,
            "retry_interval": 500,
            "node": {
                "template": "L2_node/read_status.r_u16_motor_status"
            },
            "judge": {
                "type": "exists"
            },
            "on_success": [
                {
                    "type": "log",
                    "message": "电机 ${instance_id} 状态: ${status_result}"
                },
                {
                    "type": "ui_action",
                    "action": "update_status",
                    "data": {
                        "text": "状态: ${status_result}",
                        "color": "blue"
                    }
                }
            ],
            "on_failure": [
                {
                    "type": "log",
                    "message": "电机 ${instance_id} 状态读取失败"
                },
                {
                    "type": "popup",
                    "message": "读取状态失败，请检查通信",
                    "level": "warning"
                }
            ]
        }
    ],
    "args": [
        {
            "index": 0,
            "name": "instance_id",
            "type": "s",
            "desc": "设备实例 ID"
        }
    ]
}