{
    "type": "action_bundle",
    "description": "  iDM series stepper motoraction collection v2.0",
    "version": "2.0.0",
    "actions": [
        {
            "filename": "write_register.u16_u16.r_b_write_result",
            "type": "modbus_write_verify",
            "description": "write single 16-bit register, return boolean",
            "protocol": "modbus",
            "request": "06 ${register} ${value_high} ${value_low}",
            "response": "06 ${register} ${value_high} ${value_low}",
            "timeout_ms": 3000,
            "args": [
                {
                    "index": 0,
                    "name": "register",
                    "type": "u16",
                    "min": 0,
                    "max": 65535,
                    "desc": "register address"
                },
                {
                    "index": 1,
                    "name": "value",
                    "type": "u16",
                    "min": 0,
                    "max": 65535,
                    "desc": "write value"
                }
            ]
        },
        {
            "filename": "read_register.u8_u16.r_u16_register_value",
            "type": "modbus_read_cache",
            "description": "read single 16-bit register, return uint16 value",
            "protocol": "modbus",
            "request": "03 ${register} 00 01",
            "parse": {
                "start_byte": 2,
                "length": 2,
                "endian": "big",
                "type": "uint16"
            },
            "timeout_ms": "${timeout}",
            "args": [
                {
                    "index": 0,
                    "name": "register",
                    "type": "u8",
                    "min": 0,
                    "max": 255,
                    "desc": "register address"
                },
                {
                    "index": 1,
                    "name": "timeout",
                    "type": "u16",
                    "min": 500,
                    "max": 10000,
                    "default": 2000,
                    "desc": "timeout(ms)"
                }
            ]
        },
        {
            "filename": "read_register_32.u8_u16.r_i32_position",
            "type": "modbus_read_cache",
            "description": "read 32-bit register(two consecutive registers), return int32 value",
            "protocol": "modbus",
            "request": "03 ${register} 00 02",
            "parse": {
                "start_byte": 2,
                "length": 4,
                "endian": "big",
                "type": "int32"
            },
            "timeout_ms": "${timeout}",
            "args": [
                {
                    "index": 0,
                    "name": "register",
                    "type": "u8",
                    "min": 0,
                    "max": 255,
                    "desc": "registerstart address"
                },
                {
                    "index": 1,
                    "name": "timeout",
                    "type": "u16",
                    "min": 500,
                    "max": 10000,
                    "default": 2000,
                    "desc": "timeout(ms)"
                }
            ]
        },
        {
            "filename": "check_register.u8_s_u16_u16.r_b_check_result",
            "type": "modbus_read_check",
            "description": "read register and check condition, return boolean",
            "protocol": "modbus",
            "request": "03 ${register} 00 01",
            "parse": {
                "start_byte": 2,
                "length": 2,
                "endian": "big",
                "type": "uint16"
            },
            "check": {
                "condition": "${condition}",
                "value": "${compare_value}"
            },
            "timeout_ms": "${timeout}",
            "args": [
                {
                    "index": 0,
                    "name": "register",
                    "type": "u8",
                    "min": 0,
                    "max": 255,
                    "desc": "register address"
                },
                {
                    "index": 1,
                    "name": "condition",
                    "type": "s",
                    "enum": [ "eq", "ne", "lt", "le", "gt", "ge" ],
                    "desc": "comparison condition"
                },
                {
                    "index": 2,
                    "name": "compare_value",
                    "type": "u16",
                    "min": 0,
                    "max": 65535,
                    "desc": "comparison value"
                },
                {
                    "index": 3,
                    "name": "timeout",
                    "type": "u16",
                    "min": 500,
                    "max": 10000,
                    "default": 2000,
                    "desc": "timeout(ms)"
                }
            ]
        },
        {
            "filename": "write_control_word.u16.r_b_control_result",
            "type": "modbus_write_verify",
            "description": "write control word (0x1801), return boolean",
            "protocol": "modbus",
            "request": "06 18 01 ${value_high} ${value_low}",
            "response": "06 18 01 ${value_high} ${value_low}",
            "timeout_ms": 3000,
            "args": [
                {
                    "index": 0,
                    "name": "value",
                    "type": "u16",
                    "min": 0,
                    "max": 65535,
                    "desc": "control word value"
                }
            ]
        },
        {
            "filename": "read_status.r_u16_motor_status",
            "type": "modbus_read_cache",
            "description": "read running status (0x1003), return uint16 value",
            "protocol": "modbus",
            "request": "03 10 03 00 01",
            "parse": {
                "start_byte": 2,
                "length": 2,
                "endian": "big",
                "type": "uint16"
            },
            "timeout_ms": 2000
        },
        {
            "filename": "read_alarm.r_u16_alarm_code",
            "type": "modbus_read_cache",
            "description": "read current alarm (0x2203), return uint16 value",
            "protocol": "modbus",
            "request": "03 22 03 00 01",
            "parse": {
                "start_byte": 2,
                "length": 2,
                "endian": "big",
                "type": "uint16"
            },
            "timeout_ms": 2000
        },
        {
            "filename": "motor_enable.r_b_enable_result",
            "type": "modbus_write_verify",
            "description": "motor enable (0x1801 = 0x0001), return boolean",
            "protocol": "modbus",
            "request": "06 18 01 00 01",
            "response": "06 18 01 00 01",
            "timeout_ms": 3000
        },
        {
            "filename": "motor_disable.r_b_disable_result",
            "type": "modbus_write_verify",
            "description": "motor disable (0x1801 = 0x0000), return boolean",
            "protocol": "modbus",
            "request": "06 18 01 00 00",
            "response": "06 18 01 00 00",
            "timeout_ms": 3000
        },
        {
            "filename": "jog_forward.r_b_jog_result",
            "type": "modbus_write_verify",
            "description": "JOG forward (control word 0x4001), return boolean",
            "protocol": "modbus",
            "request": "06 18 01 40 01",
            "response": "06 18 01 40 01",
            "timeout_ms": 3000
        },
        {
            "filename": "jog_reverse.r_b_jog_result",
            "type": "modbus_write_verify",
            "description": "JOG reverse (control word 0x4002), return boolean",
            "protocol": "modbus",
            "request": "06 18 01 40 02",
            "response": "06 18 01 40 02",
            "timeout_ms": 3000
        },
        {
            "filename": "jog_stop.r_b_jog_stop_result",
            "type": "modbus_write_verify",
            "description": "JOG stop (control word 0x0000), return boolean",
            "protocol": "modbus",
            "request": "06 18 01 00 00",
            "response": "06 18 01 00 00",
            "timeout_ms": 3000
        },
        {
            "filename": "trigger_pr.u16.r_b_pr_result",
            "type": "modbus_write_verify",
            "description": "trigger PR path (0x6002), return boolean",
            "protocol": "modbus",
            "request": "06 60 02 ${value_high} ${value_low}",
            "response": "06 60 02 ${value_high} ${value_low}",
            "timeout_ms": 3000,
            "args": [
                {
                    "index": 0,
                    "name": "value",
                    "type": "u16",
                    "min": 0,
                    "max": 65535,
                    "desc": "trigger value:  0x001P=path P, 0x0020=homing, 0x0040=emergency stop"
                }
            ]
        },
        {
            "filename": "trigger_homing.r_b_homing_result",
            "type": "modbus_write_verify",
            "description": "trigger homing (0x6002 = 0x0020), return boolean",
            "protocol": "modbus",
            "request": "06 60 02 00 20",
            "response": "06 60 02 00 20",
            "timeout_ms": 3000
        },
        {
            "filename": "motor_emergency_stop.r_b_estop_result",
            "type": "modbus_write_verify",
            "description": "motor emergency stop (0x6002 = 0x0040), return boolean",
            "protocol": "modbus",
            "request": "06 60 02 00 40",
            "response": "06 60 02 00 40",
            "timeout_ms": 3000
        },
        {
            "filename": "set_homing_mode.u16.r_b_mode_result",
            "type": "modbus_write_verify",
            "description": "set homing mode (0x600A), return boolean",
            "protocol": "modbus",
            "request": "06 60 0A ${value_high} ${value_low}",
            "response": "06 60 0A ${value_high} ${value_low}",
            "timeout_ms": 3000,
            "args": [
                {
                    "index": 0,
                    "name": "value",
                    "type": "u16",
                    "min": 0,
                    "max": 65535,
                    "desc": "homing mode: bit2=1origin homing, bit2=0limit homing"
                }
            ]
        },
        {
            "filename": "set_pr_mode.u16.r_b_pr_mode_result",
            "type": "modbus_write_verify",
            "description": "set PR path mode (0x6200), return boolean",
            "protocol": "modbus",
            "request": "06 62 00 ${value_high} ${value_low}",
            "response": "06 62 00 ${value_high} ${value_low}",
            "timeout_ms": 3000,
            "args": [
                {
                    "index": 0,
                    "name": "value",
                    "type": "u16",
                    "min": 0,
                    "max": 65535,
                    "desc": "mode value:  0x0001=absolute position, 0x0002=speed mode, 0x0003=homing"
                }
            ]
        },
        {
            "filename": "set_position_high.u16.r_b_position_result",
            "type": "modbus_write_verify",
            "description": "write high16 of 32-bit position (0x6201), return boolean",
            "protocol": "modbus",
            "request": "06 62 01 ${value_high} ${value_low}",
            "response": "06 62 01 ${value_high} ${value_low}",
            "timeout_ms": 3000,
            "args": [
                {
                    "index": 0,
                    "name": "value",
                    "type": "u16",
                    "min": 0,
                    "max": 65535,
                    "desc": "high16 value"
                }
            ]
        },
        {
            "filename": "set_position_low.u16.r_b_position_result",
            "type": "modbus_write_verify",
            "description": "write low16 of 32-bit position (0x6202), return boolean",
            "protocol": "modbus",
            "request": "06 62 02 ${value_high} ${value_low}",
            "response": "06 62 02 ${value_high} ${value_low}",
            "timeout_ms": 3000,
            "args": [
                {
                    "index": 0,
                    "name": "value",
                    "type": "u16",
                    "min": 0,
                    "max": 65535,
                    "desc": "low16 value"
                }
            ]
        },
        {
            "filename": "set_jog_speed.u16.r_b_jog_speed_result",
            "type": "modbus_write_verify",
            "description": "set  JOG speed (0x01E1), return boolean",
            "protocol": "modbus",
            "request": "06 01 E1 ${value_high} ${value_low}",
            "response": "06 01 E1 ${value_high} ${value_low}",
            "timeout_ms": 3000,
            "args": [
                {
                    "index": 0,
                    "name": "value",
                    "type": "u16",
                    "min": 0,
                    "max": 6000,
                    "desc": "JOG speed (rpm)"
                }
            ]
        },
        {
            "filename": "set_jog_acc.u16.r_b_jog_acc_result",
            "type": "modbus_write_verify",
            "description": "set  JOG accel/decel time (0x01E7), return boolean",
            "protocol": "modbus",
            "request": "06 01 E7 ${value_high} ${value_low}",
            "response": "06 01 E7 ${value_high} ${value_low}",
            "timeout_ms": 3000,
            "args": [
                {
                    "index": 0,
                    "name": "value",
                    "type": "u16",
                    "min": 10,
                    "max": 10000,
                    "desc": "accel/decel time (ms)"
                }
            ]
        },
        {
            "filename": "save_parameters.r_b_save_result",
            "type": "modbus_write_verify",
            "description": "save all parameters to EEPROM (0x1801 = 0x2211), return boolean",
            "protocol": "modbus",
            "request": "06 18 01 22 11",
            "response": "06 18 01 22 11",
            "timeout_ms": 5000
        },
        {
            "filename": "reset_alarm.r_b_reset_result",
            "type": "modbus_write_verify",
            "description": "reset current alarm (0x1801 = 0x1111), return boolean",
            "protocol": "modbus",
            "request": "06 18 01 11 11",
            "response": "06 18 01 11 11",
            "timeout_ms": 3000
        },
        {
            "filename": "reset_to_default.r_b_default_result",
            "type": "modbus_write_verify",
            "description": "factory reset (0x1801 = 0x2233), return boolean",
            "protocol": "modbus",
            "request": "06 18 01 22 33",
            "response": "06 18 01 22 33",
            "timeout_ms": 5000
        },
        {
            "filename": "read_position.r_i32_motor_position",
            "type": "modbus_read_cache",
            "description": "read motor current position (0x602C, 0x602D), return int32 value",
            "protocol": "modbus",
            "request": "03 60 2C 00 02",
            "parse": {
                "start_byte": 2,
                "length": 4,
                "endian": "big",
                "type": "int32"
            },
            "timeout_ms": 2000
        },
        {
            "filename": "wait.u16_s.r_b_wait_done",
            "type": "wait",
            "description": "wait specified duration, return boolean",
            "duration": "${duration}",
            "unit": "${unit}",
            "args": [
                {
                    "index": 0,
                    "name": "duration",
                    "type": "u16",
                    "min": 1,
                    "max": 3600,
                    "desc": "wait duration"
                },
                {
                    "index": 1,
                    "name": "unit",
                    "type": "s",
                    "enum": [ "seconds", "milliseconds" ],
                    "default": "seconds",
                    "desc": "time unit"
                }
            ]
        },
        {
            "filename": "log.s",
            "type": "log",
            "description": "write log message",
            "message": "${message}",
            "args": [
                {
                    "index": 0,
                    "name": "message",
                    "type": "s",
                    "desc": "Log content"
                }
            ]
        },
        {
            "filename": "popup.s_s",
            "type": "popup",
            "description": "popup prompt to user",
            "message": "${message}",
            "level": "${level}",
            "args": [
                {
                    "index": 0,
                    "name": "message",
                    "type": "s",
                    "desc": "prompt content"
                },
                {
                    "index": 1,
                    "name": "level",
                    "type": "s",
                    "enum": [ "info", "warning", "error", "success" ],
                    "default": "info",
                    "desc": "prompt level"
                }
            ]
        },
        {
            "filename": "show_status.s_s",
            "type": "ui_action",
            "description": "update status display",
            "action": "update_status",
            "data": {
                "text": "${text}",
                "color": "${color}"
            },
            "args": [
                {
                    "index": 0,
                    "name": "text",
                    "type": "s",
                    "desc": "status text"
                },
                {
                    "index": 1,
                    "name": "color",
                    "type": "s",
                    "enum": [ "red", "green", "blue", "yellow", "orange" ],
                    "default": "blue",
                    "desc": "color"
                }
            ]
        }
    ]
}